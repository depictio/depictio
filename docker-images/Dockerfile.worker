# -----------------------------
# Depictio Celery worker image
# -----------------------------
# Owns the heavy Playwright + chromium payload so the API image can stay
# lean. Runs `celery -A depictio.api.celery_worker worker` against the
# same Python codebase as the API.
# -----------------------------

# -----------------------------
# serverless template stage
# -----------------------------
# The Celery task `export_static` (producer C) injects a manifest into the
# prebuilt single-file runtime `pnpm run build:static` writes. It is gitignored
# build output, so without this stage every static export dispatched to the
# worker fails with "static runtime template not built". Node/pnpm pins mirror
# docker-images/Dockerfile.api; the runtime layer below carries no Node.
FROM node:20-slim@sha256:2cf067cfed83d5ea958367df9f966191a942351a2df77d6f0193e162b5febfc0 AS static-template-builder
WORKDIR /build
RUN corepack enable && corepack prepare pnpm@10 --activate
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY patches ./patches/
COPY packages/depictio-components/package.json ./packages/depictio-components/
COPY packages/depictio-react-core/package.json ./packages/depictio-react-core/
COPY packages/depictio-static-core/package.json ./packages/depictio-static-core/
COPY depictio/viewer/package.json ./depictio/viewer/
RUN --mount=type=cache,id=pnpm,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile
COPY packages ./packages/
COPY depictio/viewer ./depictio/viewer/
# `pnpm run icons` also scans these for icon ids named only in dashboard data
# and the kind catalogue (scripts/generate-icon-subset.mjs), as in the
# all-in-one image; without them a bundle draws those icons blank.
COPY depictio/models/components/advanced_viz/schemas.py ./depictio/models/components/advanced_viz/schemas.py
COPY depictio/projects ./depictio/projects/
RUN VITE_NO_SOURCEMAP=true NODE_OPTIONS="--max-old-space-size=4096" \
    pnpm --filter depictio-viewer build:static

FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim@sha256:e5b65587bce7de595f299855d7385fe7fca39b8a74baa261ba1b7147afa78e58 AS base

ARG VERSION=latest
LABEL org.opencontainers.image.description="Depictio worker — Celery + Playwright (screenshots, PDF export)."
LABEL org.opencontainers.image.source="https://github.com/depictio/depictio"
LABEL org.opencontainers.image.version="${VERSION:-latest}"
LABEL org.opencontainers.image.authors="Thomas Weber <thomas.weber@embl.de>"
LABEL org.opencontainers.image.licenses="MIT"

WORKDIR /app

# System deps cover Playwright's chromium runtime libs. All screenshot
# code paths use headless=True (zero xvfb/Xvfb/DISPLAY references in the
# tree), so the X virtual framebuffer isn't needed — drops ~20 MB.
#
# Fonts: the React viewer uses a pure system-font stack
# (`-apple-system, ..., Roboto, ..., sans-serif`; see viewer/src/theme.ts)
# and bundles no web font. Without a sans-serif installed here, headless
# chromium falls back to its built-in *serif* face and every dashboard
# screenshot renders in Times. `fonts-roboto` matches the stack's named
# family, `fonts-liberation` covers Arial-metric text (Plotly's default
# `arial, sans-serif`), and `fontconfig` builds the cache so the generic
# `sans-serif` keyword also resolves to a real sans face.
RUN apt-get update && apt-get install --no-install-recommends -y \
        curl \
        netcat-openbsd \
        ca-certificates \
        fontconfig \
        fonts-roboto \
        fonts-liberation \
        libnss3 \
        libnspr4 \
        libatk1.0-0 \
        libatk-bridge2.0-0 \
        libcups2 \
        libdrm2 \
        libdbus-1-3 \
        libxkbcommon0 \
        libxcomposite1 \
        libxdamage1 \
        libxfixes3 \
        libxrandr2 \
        libgbm1 \
        libasound2 \
        libpango-1.0-0 \
        libcairo2 \
    && fc-cache -f \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Quarto renders the exported notebook into the HTML report
# (`render_notebook_report`). It is a binary with its own pandoc, not a
# library, so it is installed rather than depended on: ~250 MB, for a feature
# that is off by default (DEPICTIO_NOTEBOOK_EXPORT_RENDER_ENABLED). So it is
# opt-in here too: build with `--build-arg WITH_QUARTO=true` for a worker that
# renders reports (compose: DEPICTIO_WORKER_WITH_QUARTO=true). Without it the
# notebook export, the `.qmd` download and figure extraction all work; only the
# rendered report is refused, with a message naming this build arg. It ships
# here and not in the API image: the render is worker work, minutes long and a
# browser pass per rendered tile.
ARG WITH_QUARTO=false
ARG QUARTO_VERSION=1.9.37
RUN if [ "${WITH_QUARTO}" = "true" ]; then \
        arch="$(dpkg --print-architecture)" \
        && curl -fsSL -o /tmp/quarto.deb \
            "https://github.com/quarto-dev/quarto-cli/releases/download/v${QUARTO_VERSION}/quarto-${QUARTO_VERSION}-linux-${arch}.deb" \
        && dpkg -i /tmp/quarto.deb \
        && rm /tmp/quarto.deb \
        && quarto --version; \
    else \
        echo "Quarto not installed (WITH_QUARTO=${WITH_QUARTO}): rendered notebook reports are unavailable"; \
    fi

ARG UID=1000
ARG GID=1000
RUN groupadd -g ${GID} depictio && \
    useradd -m -u ${UID} -g ${GID} -s /bin/bash depictio

# ---- Dependency layer (cached across code + version changes) ----
# Deps + editable in-tree packages WITHOUT the depictio project itself
# (--no-install-project), so a source edit or the per-release version churn in
# pyproject/VERSION doesn't reinstall everything — see Dockerfile.api for the
# full rationale.
# `--group worker-reload` adds watchdog, whose `watchmedo` run_celery_worker.sh
# needs when DEPICTIO_DEV_MODE=true. Every sync below passes it, since a sync
# without it would uninstall watchdog again.
#
# `--extra render` adds the Jupyter kernel Quarto executes the notebook
# through. Without it Quarto renders a report with every result missing, and
# exits 0 while doing it.
COPY --chown=depictio:depictio pyproject.toml uv.lock* ./
# Only the two Python packages [tool.uv.sources] installs from the checkout.
# The rest of packages/ is the JS workspace (depictio-react-core and co.),
# edited by most front-end changes: copied here, it re-ran this whole layer
# (and the browser download below it) for a change no Python dep can see.
# It lands with the source in the project layer instead.
COPY --chown=depictio:depictio packages/plotly-complexheatmap ./packages/plotly-complexheatmap/
COPY --chown=depictio:depictio packages/plotly-upset ./packages/plotly-upset/
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-install-project --no-dev --extra server --extra render --group worker-reload \
    || uv sync --no-install-project --no-dev --extra server --extra render --group worker-reload

# Browser bundle target inside the image. We download into a BuildKit
# cache mount and copy out — caches the chromium payload across rebuilds
# so editing Python doesn't reinvalidate the download.
#
# `--only-shell`: every screenshot/PDF path calls
# `p.chromium.launch(headless=True)` (no headless=False, no channel=), so we
# install ONLY chromium-headless-shell — Playwright auto-selects it for
# headless launches. Skips the full headed chromium browser, cutting the
# browser layer roughly in half (~900 MB → ~450 MB).
#
# We also drop `--with-deps`: every shared library the shell needs is already
# apt-installed above, and `--with-deps` would re-run apt over the same set.
# Installed off the dependency layer (playwright is a dep), so the chromium
# download only re-runs when deps change — not on source/version edits.
# --no-sync runs from the already-synced env without pulling in the
# not-yet-installed project (its source isn't copied until the layer below).
ENV PLAYWRIGHT_BROWSERS_PATH=/usr/local/share/playwright-browsers
RUN --mount=type=cache,target=/var/cache/playwright,sharing=locked \
    mkdir -p ${PLAYWRIGHT_BROWSERS_PATH} && \
    PLAYWRIGHT_BROWSERS_PATH=/var/cache/playwright \
        uv run --no-sync playwright install --only-shell && \
    cp -a /var/cache/playwright/. ${PLAYWRIGHT_BROWSERS_PATH}/ && \
    chmod -R 755 ${PLAYWRIGHT_BROWSERS_PATH}

# ---- Project layer (source + VERSION last) ----
# `--extra render` again: `uv sync` makes the environment match what it is
# given, so leaving it off here would uninstall the kernel the layer above
# installed.
COPY --chown=depictio:depictio VERSION ./
COPY --chown=depictio:depictio depictio ./depictio/
COPY --chown=depictio:depictio packages ./packages/
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --extra server --extra render --group worker-reload \
    || uv sync --no-dev --extra server --extra render --group worker-reload

# The serverless bundle template, built in the stage above.
COPY --from=static-template-builder --chown=depictio:depictio \
    /build/depictio/viewer/dist-static/static.html \
    /app/depictio/viewer/dist-static/static.html
# The report runtime, built by the same `build:static`: `render_notebook_report`
# inlines it beside producer A's manifest so the report's tiles are the
# dashboard's own renderers (depictio/serverless/report.py). Without it the
# report keeps every tile's own output.
COPY --from=static-template-builder --chown=depictio:depictio \
    /build/depictio/viewer/dist-static/report-runtime.js \
    /build/depictio/viewer/dist-static/report-runtime.css \
    /app/depictio/viewer/dist-static/

COPY --chown=depictio:depictio docker-images/run_celery_worker.sh /app/run_celery_worker.sh
RUN chmod +x /app/run_celery_worker.sh

ENV PATH="/app/.venv/bin:${PATH}"
ENV PYTHONPATH="/app"
ENV PYTHONUNBUFFERED=1

USER depictio

CMD ["/app/run_celery_worker.sh"]
