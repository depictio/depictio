# -----------------------------
# Depictio Celery worker image
# -----------------------------
# Owns the heavy Playwright + chromium payload so the API image can stay
# lean. Runs `celery -A depictio.api.celery_worker worker` against the
# same Python codebase as the API.
# -----------------------------

FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim@sha256:e5b65587bce7de595f299855d7385fe7fca39b8a74baa261ba1b7147afa78e58 AS base

ARG VERSION=latest
LABEL org.opencontainers.image.description="Depictio worker — Celery + Playwright (screenshots, PDF export)."
LABEL org.opencontainers.image.source="https://github.com/depictio/depictio"
LABEL org.opencontainers.image.version="${VERSION:-latest}"
LABEL org.opencontainers.image.authors="Thomas Weber <thomas.weber@embl.de>"
LABEL org.opencontainers.image.licenses="MIT"

WORKDIR /app

# System deps cover Playwright's chromium runtime libs. All screenshot
# code paths use headless=True (zero xvfb/Xvfb/DISPLAY references in the
# tree), so the X virtual framebuffer isn't needed — drops ~20 MB.
#
# Fonts: the React viewer uses a pure system-font stack
# (`-apple-system, ..., Roboto, ..., sans-serif`; see viewer/src/theme.ts)
# and bundles no web font. Without a sans-serif installed here, headless
# chromium falls back to its built-in *serif* face and every dashboard
# screenshot renders in Times. `fonts-roboto` matches the stack's named
# family, `fonts-liberation` covers Arial-metric text (Plotly's default
# `arial, sans-serif`), and `fontconfig` builds the cache so the generic
# `sans-serif` keyword also resolves to a real sans face.
RUN apt-get update && apt-get install --no-install-recommends -y \
        curl \
        netcat-openbsd \
        ca-certificates \
        fontconfig \
        fonts-roboto \
        fonts-liberation \
        libnss3 \
        libnspr4 \
        libatk1.0-0 \
        libatk-bridge2.0-0 \
        libcups2 \
        libdrm2 \
        libdbus-1-3 \
        libxkbcommon0 \
        libxcomposite1 \
        libxdamage1 \
        libxfixes3 \
        libxrandr2 \
        libgbm1 \
        libasound2 \
        libpango-1.0-0 \
        libcairo2 \
    && fc-cache -f \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Quarto renders the exported notebook into the HTML report
# (`render_notebook_report`). It is a binary with its own pandoc, not a
# library, so it is installed rather than depended on — ~250 MB, which is why
# the feature it serves is off by default (DEPICTIO_NOTEBOOK_EXPORT_RENDER_*).
# It ships here and not in the API image: the render is worker work, minutes
# long and a browser pass per rendered tile.
ARG QUARTO_VERSION=1.9.37
RUN arch="$(dpkg --print-architecture)" \
    && curl -fsSL -o /tmp/quarto.deb \
        "https://github.com/quarto-dev/quarto-cli/releases/download/v${QUARTO_VERSION}/quarto-${QUARTO_VERSION}-linux-${arch}.deb" \
    && dpkg -i /tmp/quarto.deb \
    && rm /tmp/quarto.deb \
    && quarto --version

ARG UID=1000
ARG GID=1000
RUN groupadd -g ${GID} depictio && \
    useradd -m -u ${UID} -g ${GID} -s /bin/bash depictio

# ---- Dependency layer (cached across code + version changes) ----
# Deps + editable in-tree packages WITHOUT the depictio project itself
# (--no-install-project), so a source edit or the per-release version churn in
# pyproject/VERSION doesn't reinstall everything — see Dockerfile.api for the
# full rationale.
#
# `--extra render` adds the Jupyter kernel Quarto executes the notebook
# through. Without it Quarto renders a report with every result missing, and
# exits 0 while doing it.
COPY --chown=depictio:depictio pyproject.toml uv.lock* ./
COPY --chown=depictio:depictio packages ./packages/
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-install-project --no-dev --extra render \
    || uv sync --no-install-project --no-dev --extra render

# Browser bundle target inside the image. We download into a BuildKit
# cache mount and copy out — caches the chromium payload across rebuilds
# so editing Python doesn't reinvalidate the download.
#
# `--only-shell`: every screenshot/PDF path calls
# `p.chromium.launch(headless=True)` (no headless=False, no channel=), so we
# install ONLY chromium-headless-shell — Playwright auto-selects it for
# headless launches. Skips the full headed chromium browser, cutting the
# browser layer roughly in half (~900 MB → ~450 MB).
#
# We also drop `--with-deps`: every shared library the shell needs is already
# apt-installed above, and `--with-deps` would re-run apt over the same set.
# Installed off the dependency layer (playwright is a dep), so the chromium
# download only re-runs when deps change — not on source/version edits.
# --no-sync runs from the already-synced env without pulling in the
# not-yet-installed project (its source isn't copied until the layer below).
ENV PLAYWRIGHT_BROWSERS_PATH=/usr/local/share/playwright-browsers
RUN --mount=type=cache,target=/var/cache/playwright,sharing=locked \
    mkdir -p ${PLAYWRIGHT_BROWSERS_PATH} && \
    PLAYWRIGHT_BROWSERS_PATH=/var/cache/playwright \
        uv run --no-sync playwright install --only-shell && \
    cp -a /var/cache/playwright/. ${PLAYWRIGHT_BROWSERS_PATH}/ && \
    chmod -R 755 ${PLAYWRIGHT_BROWSERS_PATH}

# ---- Project layer (source + VERSION last) ----
# `--extra render` again: `uv sync` makes the environment match what it is
# given, so leaving it off here would uninstall the kernel the layer above
# installed.
COPY --chown=depictio:depictio VERSION ./
COPY --chown=depictio:depictio depictio ./depictio/
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --extra render || uv sync --no-dev --extra render

COPY --chown=depictio:depictio docker-images/run_celery_worker.sh /app/run_celery_worker.sh
RUN chmod +x /app/run_celery_worker.sh

ENV PATH="/app/.venv/bin:${PATH}"
ENV PYTHONPATH="/app"
ENV PYTHONUNBUFFERED=1

USER depictio

CMD ["/app/run_celery_worker.sh"]
