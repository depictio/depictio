// For module_artifact.nf, module_nfcore.nf and module_cli_config.nf. `image` is the all-in-one image under test, in place of
// the release tag the module pins (not published yet when a PR is checked). It is
// set with withName: a plain process.container does not override the module's
// own `container` directive.
params {
    iris        = null
    // module_nfcore.nf: a finished nf-core run and its samplesheet.
    results     = null
    samplesheet = null
    // module_cli_config.nf: the CLI configuration of a running instance.
    cli_config  = null
    outdir = 'results'
    image  = 'depictio-allinone:ci'
}

process {
    withName: 'DEPICTIO_INGEST' {
        publishDir = [path: { "${params.outdir}/depictio" }, mode: 'copy']
    }
}

env {
    DEPICTIO_TELEMETRY_ENABLED = 'false'
}

profiles {
    docker {
        process {
            withName: 'DEPICTIO_INGEST' {
                container = params.image
            }
        }
        docker.enabled    = true
        // As nf-core pipelines run it: the host's uid, which the image does not know.
        // Read-only, with a private /tmp, as under Apptainer: only the work
        // directory (and the anonymous /data volume, unused) can be written.
        docker.runOptions = '-u $(id -u):$(id -g) --read-only --tmpfs /tmp:rw,exec,size=2g'
    }
    // With docker, for module_cli_config.nf: the task reaches the instance's API
    // and S3 on the runner's 127.0.0.1. Comes after `docker` in -profile.
    hostnet {
        docker.runOptions = '-u $(id -u):$(id -g) --read-only --tmpfs /tmp:rw,exec,size=2g --network host'
    }
    // `image` is the path of a .sif here. Apptainer runs the image read-only, as
    // the user, with the node's /tmp: what a cluster gives a task.
    apptainer {
        process {
            withName: 'DEPICTIO_INGEST' {
                container = params.image
            }
        }
        apptainer.enabled  = true
        apptainer.autoMounts = true
    }
}
