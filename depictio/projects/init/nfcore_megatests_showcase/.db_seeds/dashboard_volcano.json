      "last_updated": "2026-05-12T00:00:00.000000",
      "title_size": "sm",
      "title_align": "left",
      "section": "About this showcase",
      "order": 4,
      "alignment": "left",
      "vertical_alignment": "top",
      "body": "This project binds depictio's advanced visualisations to real nf-core pipeline\noutputs pulled from the public AWS megatests bucket: differentialabundance,\nrnaseq, viralrecon, ampliseq and taxprofiler. Unlike the Advanced Visualisations\nshowcase, which uses synthetic fixtures sized to make each component legible,\neverything here is a genuine result with the gaps and skew real runs have. The\nfixtures are not in the repository and this project is not seeded on a fresh\ndeployment; see the README next to project.yaml for how to build and upload it.\n",
      "wf_tag": "nf-core/nfcore_megatests"
    }
