    {
      "index": "omz-reg-text",
      "component_type": "text",
      "title": "A registration, step by step",
      "workflow_tag": "",
      "data_collection_tag": "",
      "wf_id": {
        "$oid": "646b0f3c1e4a2d7f8e5b8f01"
