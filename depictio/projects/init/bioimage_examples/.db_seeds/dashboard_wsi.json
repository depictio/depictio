    {
      "index": "omz-wsi-text",
      "component_type": "text",
      "title": "Overview and detail on one slide",
      "workflow_tag": "",
      "data_collection_tag": "",
      "wf_id": {
        "$oid": "646b0f3c1e4a2d7f8e5b8f01"
      },
      "dc_id": null,
