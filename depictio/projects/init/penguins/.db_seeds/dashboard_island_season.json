      "last_updated": "2026-05-20T00:00:00",
      "title_size": "sm",
      "title_align": "left",
      "section": "Island composition",
      "order": 2,
      "alignment": "left",
      "vertical_alignment": "center",
      "body": "*Adelie* is on all three islands (51 Torgersen, 56 Dream, 44 Biscoe), *Chinstrap* only on Dream (68), *Gentoo* only on Biscoe (123). So island and species are confounded for two of the three: narrow to *Adelie* in the **Cohort** filter to compare islands honestly.",
      "wf_tag": "python/penguin_species_analysis"
    },
