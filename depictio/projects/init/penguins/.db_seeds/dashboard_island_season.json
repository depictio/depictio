    {
      "index": "08b60daf-9d14-519f-bbf7-2257ba7edbc8",
      "component_type": "text",
      "title": "Three seasons, one population",
      "workflow_tag": "",
      "data_collection_tag": "",
      "wf_id": {
        "$oid": "646b0f3c1e4a2d7f8e5b8c9e"
