    {
      "index": "text-recipe-lane",
      "component_type": "text",
      "title": "The recipe lane",
      "workflow_tag": "python/catalog_conformance",
      "data_collection_tag": "qiime2_ancombc",
      "wf_id": {
        "$oid": "045f1f968289500c09ea3939"
