      "description": "The sepal side, drawn as violins so the full shape shows: Versicolor and Virginica overlap across most of their range and both are broad rather than tight, which is why the sepal-only panels of the matrix look mixed.",
      "title_size": "h3",
      "title_align": "left",
      "section": "Distributions",
      "visu_type": "scatter",
      "dict_kwargs": {},
      "mode": "code",
      "code_content": "fig = px.violin(\n    df.to_pandas(),\n    x='variety', y='sepal.length', color='variety',\n    box=True, points='all',\n    color_discrete_map={'Setosa': '#4C72B0', 'Versicolor': '#DD8452', 'Virginica': '#55A467'},\n    labels={'sepal.length': 'Sepal length (cm)', 'variety': 'Variety'},\n)\nfig.update_traces(meanline_visible=True, marker=dict(size=4, opacity=0.6))\n",
      "displayed_data_count": 0,
