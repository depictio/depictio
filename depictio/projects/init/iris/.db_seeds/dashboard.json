    {
      "index": "870a8f03-4ada-5979-ae2c-05741766dd9b",
      "component_type": "text",
      "title": "Where the varieties separate",
      "workflow_tag": "",
      "data_collection_tag": "",
      "wf_id": {
        "$oid": "646b0f3c1e4a2d7f8e5b8c9b"
      },
      "dc_id": null,
      "dc_config": {},
      "cols_json": {},
      "parent_index": null,
      "last_updated": "2026-05-20T00:00:00",
      "title_size": "sm",
      "title_align": "left",
      "section": "Distributions",
      "order": 2,
      "alignment": "left",
      "vertical_alignment": "center",
      "body": "*Setosa* separates on petal size alone \u2014 it is linearly separable from the other two on either petal axis. *Versicolor* and *Virginica* overlap on every single measurement and only pull apart when petal length and width are read together, which is what the scatter matrix is for. Filter to one variety on the left and watch which panels stop being informative.",
      "wf_tag": "python/iris_workflow"
    },
    {
      "index": "b9a5a44b-6e93-5f2e-88e5-4f3dc04b781f",
      "component_type": "figure",
      "title": "Iris pairwise measurements",
      "workflow_tag": "python/iris_workflow",
      "data_collection_tag": "iris_table",
      "wf_id": {
        "$oid": "646b0f3c1e4a2d7f8e5b8c9b"
      },
      "dc_id": {
        "$oid": "646b0f3c1e4a2d7f8e5b8c9c"
      },
      "dc_config": {
        "type": "table",
        "metatype": "Metadata",
        "description": "Iris dataset in CSV format",
        "data_collection_tag": "iris_table",
        "dc_specific_properties": null,
        "_id": {
          "$oid": "646b0f3c1e4a2d7f8e5b8c9c"
        }
      },
      "cols_json": {},
      "parent_index": null,
      "last_updated": "2026-05-20T00:00:00",
      "description": "Scatter matrix across all four measurements (seaborn deep palette). Off-diagonal = pairwise scatter, diagonal = per-variable distribution. Every panel involving a petal measurement shows Setosa detached; no sepal-only panel does.",
      "title_size": "h3",
      "title_align": "left",
      "section": "Distributions",
      "visu_type": "scatter",
      "dict_kwargs": {},
      "mode": "code",
      "code_content": "df_pd = df.to_pandas()\nfig = px.scatter_matrix(\n    df_pd,\n    dimensions=['sepal.length', 'sepal.width', 'petal.length', 'petal.width'],\n    color='variety',\n    color_discrete_map={'Setosa': '#4C72B0', 'Versicolor': '#DD8452', 'Virginica': '#55A467'},\n    labels={'sepal.length': 'Sepal L', 'sepal.width': 'Sepal W', 'petal.length': 'Petal L', 'petal.width': 'Petal W'},\n)\nfig.update_traces(diagonal_visible=True, showupperhalf=True, marker=dict(size=4, opacity=0.75, line=dict(width=0.4, color='white')))\nfig.update_layout(dragmode='select')\n",
      "displayed_data_count": 0,
      "total_data_count": 0,
      "was_sampled": false,
      "filter_applied": false,
      "max_points": null,
      "selection_enabled": false,
      "selection_column": null,
      "font_scale": null,
      "wf_tag": "python/iris_workflow"
    },
