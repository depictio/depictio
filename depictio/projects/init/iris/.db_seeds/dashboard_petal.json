    {
      "index": "d2a2b3cc-47c2-590f-9403-ccc0b77fb0be",
      "component_type": "figure",
      "title": "Petal Length vs Width \u2014 where the mass sits",
      "workflow_tag": "python/iris_workflow",
      "data_collection_tag": "iris_table",
      "wf_id": {
        "$oid": "646b0f3c1e4a2d7f8e5b8c9b"
      },
      "dc_id": {
        "$oid": "646b0f3c1e4a2d7f8e5b8c9c"
      },
      "dc_config": {
        "type": "table",
        "metatype": "Metadata",
        "description": "Iris dataset in CSV format",
        "data_collection_tag": "iris_table",
        "dc_specific_properties": null,
        "_id": {
          "$oid": "646b0f3c1e4a2d7f8e5b8c9c"
        }
      },
      "cols_json": {},
      "parent_index": null,
      "last_updated": "2026-05-20T00:00:00",
      "description": "Filled contours are per-variety density; the dots underneath are the individual flowers. Setosa occupies a small, tight island; Versicolor and Virginica form one elongated ridge that the contours show meeting rather than overlapping.",
      "title_size": "h3",
      "title_align": "left",
      "section": "Petal geometry",
      "visu_type": "scatter",
      "dict_kwargs": {},
      "mode": "code",
      "code_content": "df_pd = df.to_pandas()\npalette = {'Setosa': '#4C72B0', 'Versicolor': '#DD8452', 'Virginica': '#55A467'}\nfig = px.density_contour(\n    df_pd, x='petal.length', y='petal.width', color='variety',\n    color_discrete_map=palette,\n    labels={'petal.length': 'Petal length (cm)', 'petal.width': 'Petal width (cm)'},\n)\nfig.update_traces(contours_coloring='fill', contours_showlines=False, opacity=0.45)\nfor name, colour in palette.items():\n    sub = df_pd[df_pd['variety'] == name]\n    fig.add_scatter(\n        x=sub['petal.length'], y=sub['petal.width'], mode='markers', name=name,\n        marker=dict(size=5, color=colour, opacity=0.55,\n                    line=dict(width=0.4, color='white')),\n        showlegend=False,\n    )\n",
      "displayed_data_count": 0,
      "total_data_count": 0,
      "was_sampled": false,
      "filter_applied": false,
      "max_points": null,
      "selection_enabled": false,
      "selection_column": null,
      "font_scale": null,
      "wf_tag": "python/iris_workflow"
    },
    {
      "index": "207cdefc-4329-5738-aaa4-35f279b44356",
      "component_type": "figure",
      "title": "Petal Length \u2014 cumulative share by variety",
      "workflow_tag": "python/iris_workflow",
      "data_collection_tag": "iris_table",
      "wf_id": {
        "$oid": "646b0f3c1e4a2d7f8e5b8c9b"
