      "cols_json": {},
      "parent_index": null,
      "last_updated": "2026-05-20T00:00:00",
      "description": "Each curve is the share of that variety at or below a given petal length. Where a curve is flat, no flowers occupy that range. The dashed line marks the 4 cm cut the filter above uses: read off each curve to see what it keeps.",
      "title_size": "h3",
      "title_align": "left",
      "section": "Variety separation",
      "visu_type": "scatter",
      "dict_kwargs": {},
      "mode": "code",
      "code_content": "fig = px.ecdf(\n    df.to_pandas(),\n    x='petal.length',\n    color='variety',\n    color_discrete_map={'Setosa': '#4C72B0', 'Versicolor': '#DD8452', 'Virginica': '#55A467'},\n    labels={'petal.length': 'Petal length (cm)'},\n)\nfig.add_vline(x=4, line_dash='dash', line_color='#8C8C8C',\n              annotation_text='4 cm cut', annotation_position='top left')\nfig.update_traces(line=dict(width=2.5))\nfig.update_yaxes(title_text='Cumulative share')\n",
      "displayed_data_count": 0,
      "total_data_count": 0,
      "was_sampled": false,
      "filter_applied": false,
      "max_points": null,
      "selection_enabled": false,
