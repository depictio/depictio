    {
      "index": "8769d4ea-2b17-5bc0-bf44-64196f6b0502",
      "component_type": "text",
      "title": "Petal Geometry as a Species Signal",
      "workflow_tag": "",
      "data_collection_tag": "",
      "wf_id": {
        "$oid": "646b0f3c1e4a2d7f8e5b8c9b"
      },
      "dc_id": null,
      "dc_config": {},
      "cols_json": {},
      "parent_index": null,
      "last_updated": "2026-05-20T00:00:00",
      "title_size": "sm",
      "title_align": "left",
      "section": "Petal geometry",
      "order": 2,
      "alignment": "left",
      "vertical_alignment": "center",
      "body": "Petal length \u00d7 width is the cleanest variety separator in Fisher's dataset. These four cards summarise the two petal columns and put sepal length beside them for contrast \u2014 the sepal spread overlaps across all three varieties where the petal spread does not. Note the `Raw Data` section at the bottom of this tab: it is declared on the Overview and follows you here, cards included.",
      "wf_tag": "python/iris_workflow"
    },
    {
      "index": "608b2db2-42dd-5fc2-bdba-06a6bb9c5d38",
      "component_type": "text",
      "title": "How much one threshold buys",
      "workflow_tag": "",
      "data_collection_tag": "",
      "wf_id": {
        "$oid": "646b0f3c1e4a2d7f8e5b8c9b"
      },
      "dc_id": null,
      "dc_config": {},
      "cols_json": {},
      "parent_index": null,
      "last_updated": "2026-05-20T00:00:00",
      "title_size": "sm",
      "title_align": "left",
      "section": "Variety separation",
      "order": 2,
      "alignment": "left",
      "vertical_alignment": "center",
      "body": "The cards ask what a single petal-length cut-off actually classifies, and the figures show what it costs. A cut at 4 cm keeps every *Virginica* and one *Versicolor*; pushing it higher trades recall for purity. The box plots below are where that trade is visible \u2014 the *Versicolor* and *Virginica* boxes overlap on length far more than on width.",
      "wf_tag": "python/iris_workflow"
    },
