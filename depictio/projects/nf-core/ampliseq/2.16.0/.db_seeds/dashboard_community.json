    {
      "index": "community-composition-header",
      "component_type": "text",
      "title": "What the samples are made of",
      "workflow_tag": "ampliseq",
      "data_collection_tag": "",
      "wf_id": {
        "$oid": "646b0f3c1e4a2d7f8e5b8ca3"
