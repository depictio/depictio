        "title": "Mean Relative Abundance by Habitat",
        "x": "Phylum",
        "y": "mean_rel_abundance"
      },
      "mode": "code",
      "code_content": "df_grp = df.with_columns(pl.col('habitat').alias('_facet')) if 'habitat' in df.columns else df.with_columns(pl.lit('All samples').alias('_facet'))\ndf_modified = df_grp.group_by(['_facet', 'Phylum']).agg(pl.col('rel_abundance').mean().alias('mean_rel_abundance')).sort('Phylum')\nfig = px.bar(\n    df_modified.to_pandas(),\n    x='Phylum', y='mean_rel_abundance', color='Phylum',\n    facet_row='_facet',\n    title='Mean Relative Abundance by Habitat',\n    labels={'Phylum': 'Phylum', 'mean_rel_abundance': 'Mean Relative Abundance'},\n)\nfig.update_layout(xaxis={'categoryorder': 'category ascending'})\nfig.update_xaxes(tickangle=-45, tickfont={'size': 9})\nfig.update_layout(showlegend=False)",
