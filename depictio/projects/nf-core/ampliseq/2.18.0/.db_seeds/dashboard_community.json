      "wf_id": {
        "$oid": "646b0f3c1e4a2d7f8e5b8ca3"
      },
      "dc_id": {
        "$oid": "646b0f3c1e4a2d7f8e5b8cd6"
      },
      "dc_config": {
        "type": null,
        "metatype": null,
        "description": "UpSet-ready taxon \u00d7 habitat binary presence matrix",
        "data_collection_tag": "upset_canonical",
        "dc_specific_properties": null,
        "_id": {
          "$oid": "646b0f3c1e4a2d7f8e5b8cd6"
        }
      },
      "cols_json": {},
      "parent_index": null,
      "last_updated": "2026-08-29T00:00:00.000000",
      "description": "Which phyla do the groups share, and which belong to one group only? Each column of dots is a combination of groups, the bar above it counts the phyla found in exactly those groups, and the bars at the left give each group's total. Bars of a single group take that group's colour.\nHow to read: a tall bar for all groups together is the shared core, and tall single-group bars are phyla specific to one group. Few shared phyla means very different communities. An annotation track under the bars breaks each combination down by kingdom and phylum.\nLines and annotations: no reference line is drawn. Bars are sorted by size, largest first, and every combination of at least one phylum is shown.\nSource: Lex et al. 2014 (UpSet), https://doi.org/10.1109/TVCG.2014.2346248\nNote: a phylum counts as present in a group when its relative abundance is above 0.1% in at least one sample of that group. This presence level is set by the dashboard's recipe to drop noise and is not a published cut-off.",
      "title_size": "sm",
      "title_align": "left",
      "section": "Set overlap",
      "viz_kind": "upset_plot",
      "config": {
        "controls_placement": "popover",
        "viz_kind": "upset_plot",
        "matrix_wf_id": {
          "$oid": "646b0f3c1e4a2d7f8e5b8ca3"
        },
        "matrix_dc_id": {
          "$oid": "646b0f3c1e4a2d7f8e5b8cd6"
        },
        "set_columns": null,
        "set_columns_pattern": null,
