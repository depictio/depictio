        }
      },
      "cols_json": {},
      "parent_index": null,
      "last_updated": "2026-08-29T00:00:00.000000",
      "description": "The eight most abundant phyla of each group, the rest folded into Other.",
      "title_size": "sm",
      "title_align": "left",
      "use": "qiime2/rel_abundance",
      "catalog_source": {
        "toolId": "qiime2",
        "toolName": "QIIME 2",
        "outputId": "qiime2_rel_abundance",
        "use": "qiime2/rel_abundance",
        "description": "Per-sample relative-abundance table with taxonomy ranks."
      },
      "section": "Composition",
      "fit": "auto",
      "visu_type": "bar",
      "dict_kwargs": {},
      "mode": "code",
      "code_content": "# One 100% bar per group: the eight most abundant phyla of the samples in view,\n# the rest folded into Other. The groups are Analysis mode's when it has some.\ngrp = depictio_group_by[0] if depictio_group_by else 'habitat'\nd = df if grp in df.columns else df.with_columns(pl.lit('All samples').alias(grp))\ntop = d.group_by('Phylum').agg(pl.col('rel_abundance').sum().alias('n')).sort('n', descending=True).head(8)['Phylum'].to_list()\nd = d.filter(pl.col(grp).is_not_null()).with_columns(pl.when(pl.col('Phylum').is_in(top)).then(pl.col('Phylum')).otherwise(pl.lit('Other')).alias('Phylum'))\nshares = d.group_by([grp, 'Phylum']).agg(pl.col('rel_abundance').sum().alias('n')).with_columns((pl.col('n') / pl.col('n').sum().over(grp) * 100).alias('share')).sort(grp)\norders = dict(depictio_group_kwargs.get('category_orders') or {}, Phylum=top + ['Other'])\nfig = px.bar(shares.to_pandas(), x='share', y=grp, color='Phylum', orientation='h', category_orders=orders, color_discrete_map=depictio_category_colors.get('Phylum') or {}, labels={grp: '', 'share': 'Share of the community (%)'})\nfig.update_layout(barmode='stack', xaxis_range=[0, 100], margin=dict(t=10))\nfig.update_yaxes(automargin=True)",
      "displayed_data_count": 0,
      "total_data_count": 0,
      "was_sampled": false,
      "filter_applied": false,
      "max_points": null,
      "selection_enabled": false,
      "selection_column": null,
      "font_scale": null,
      "wf_tag": "nextflow/ampliseq"
    },
