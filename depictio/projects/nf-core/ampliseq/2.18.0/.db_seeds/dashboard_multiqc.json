      "parent_index": null,
      "last_updated": "2026-08-29T00:00:00.000000",
      "title_size": "sm",
      "title_align": "left",
      "section": "QC overview",
      "order": 2,
      "alignment": "left",
      "vertical_alignment": "center",
      "body": "[MultiQC](https://multiqc.info) aggregates the per-sample [FastQC](https://www.bioinformatics.babraham.ac.uk/projects/fastqc/) and [Cutadapt](https://cutadapt.readthedocs.io) reports for this run. The four panels here answer the questions asked first: how many reads survived trimming, how evenly they are spread across samples, and whether base quality holds to the end of the read. The remaining ten panels are folded into *QC details* below. Pick a sample on the left to narrow every panel at once.",
      "wf_tag": "nextflow/ampliseq"
    },
