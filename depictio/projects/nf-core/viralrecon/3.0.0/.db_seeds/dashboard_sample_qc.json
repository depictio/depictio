      "code_content": "# Nextclade's reading of each consensus genome, in two panels because the counts differ by\n# orders of magnitude: the substitutions and deleted bases it finds against the reference\n# (top) and the bases it could not read (bottom, log axis), the most missing bases first.\n# The dot above each bottom bar is the sample's Nextclade QC verdict.\ncolors = depictio_category_colors.get('qc_overallStatus') or {}\nnames = {'totalSubstitutions': 'Substitutions', 'totalDeletions': 'Deleted bases', 'totalMissing': 'Missing bases'}\nd = df.with_columns(pl.col('totalMissing').fill_null(0)).sort(['totalMissing', 'sample'], descending=[True, False])\nlong = d.select(['sample', *names.keys()]).unpivot(index='sample', variable_name='kind', value_name='n').with_columns(pl.col('n').fill_null(0), pl.col('kind').replace(names))\nfig = px.bar(long.to_pandas(), x='sample', y='n', color='kind', custom_data=['sample'], category_orders={'sample': d.get_column('sample').to_list(), 'kind': list(names.values())}, labels={'sample': '', 'n': '', 'kind': ''})\nbars = fig\nfig = go.Figure()\nfig.set_subplots(rows=2, cols=1, shared_xaxes=True, row_heights=[0.5, 0.5], vertical_spacing=0.08)\nfor trace in bars.data:\n    fig.add_trace(trace, row=2 if trace.name == 'Missing bases' else 1, col=1)\nfor status in ['good', 'mediocre', 'bad']:\n    sub = d.filter(pl.col('qc_overallStatus') == status)\n    if not sub.is_empty():\n        fig.add_scatter(x=sub.get_column('sample').to_list(), y=[max(m, 1) * 1.5 for m in sub.get_column('totalMissing').to_list()], mode='markers', name='Nextclade QC ' + status, marker=dict(color=colors.get(status), size=10), customdata=[[s] for s in sub.get_column('sample').to_list()], hovertemplate='%{x}: ' + status + '<extra></extra>', row=2, col=1)\nfig.update_yaxes(title_text='Differences', row=1, col=1)\nfig.update_yaxes(title_text='Missing bases', type='log', row=2, col=1)\nfig.update_xaxes(tickangle=-45, tickfont={'size': 9})\nfig.update_layout(barmode='stack', margin=dict(t=10), legend=dict(orientation='h', y=-0.3))",
