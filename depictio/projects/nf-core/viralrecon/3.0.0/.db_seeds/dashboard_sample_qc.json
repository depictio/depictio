      "cols_json": {},
      "parent_index": null,
      "last_updated": "2026-08-29T00:00:00.000000",
      "description": "A thin sample sits low and left; a deep one under the line lost amplicons. Coverage only, the consensus is rated below.",
      "title_size": "sm",
      "title_align": "left",
      "use": "multiqc/summary_metrics",
      "catalog_source": {
        "toolId": "multiqc",
        "toolName": "MultiQC",
        "outputId": "multiqc_summary_metrics",
        "use": "multiqc/summary_metrics",
        "description": "Per-sample variant-calling summary (reads mapped, coverage, SNP/indel/total variant counts, lineage) parsed from MultiQC's summary_variants_metrics table."
      },
      "section": "Depth and breadth",
      "visu_type": "scatter",
      "dict_kwargs": {},
      "mode": "code",
      "code_content": "# Depth against 10x breadth, one point per sample, coloured by verdict: a\n# sample passes with 80% of the genome at 10x and a median depth of 10x or\n# more, and the shaded corners are where it fails. Depth on a log axis:\n# samples of one run span orders of magnitude. A failing sample carries its name.\nd = df.filter(pl.col('coverage_median').is_not_null() & (pl.col('coverage_median') > 0) & pl.col('pct_genome_covered_10x').is_not_null())\nd = d.with_columns(pl.when((pl.col('pct_genome_covered_10x') >= 80) & (pl.col('coverage_median') >= 10)).then(pl.lit('pass')).otherwise(pl.lit('fail')).alias('qc_status')).with_columns(pl.when(pl.col('qc_status') == 'fail').then(pl.col('sample')).otherwise(pl.lit('')).alias('flag'))\nlow = min(d['coverage_median'].min() or 10, 10) / 2\ntop = max(d['coverage_median'].max() or 10, 10) * 2\nfig = px.scatter(d.to_pandas(), x='coverage_median', y='pct_genome_covered_10x', color='qc_status', color_discrete_map=depictio_category_colors.get('qc_status') or {}, category_orders={'qc_status': ['pass', 'fail']}, log_x=True, text='flag', hover_data=['sample', 'num_variants_total'], labels={'coverage_median': 'Median depth', 'pct_genome_covered_10x': 'Genome at 10x (%)', 'qc_status': 'Verdict', 'num_variants_total': 'Variants called'})\nfig.add_hrect(y0=0, y1=80, fillcolor='rgba(224, 49, 49, 0.08)', line_width=0, layer='below')\nfig.add_vrect(x0=low, x1=10, fillcolor='rgba(224, 49, 49, 0.08)', line_width=0, layer='below')\nfig.add_hline(y=80, line_dash='dash', line_width=1, opacity=0.6, annotation_text='80%')\nfig.add_vline(x=10, line_dash='dash', line_width=1, opacity=0.6, annotation_text='10x')\nfig.update_traces(marker=dict(size=14), textposition='top center')\nfig.update_xaxes(range=[np.log10(low), np.log10(top)])\nfig.update_yaxes(range=[0, 105])\nfig.update_layout(margin=dict(t=10), legend_title_text='')",
      "displayed_data_count": 0,
      "total_data_count": 0,
      "was_sampled": false,
      "filter_applied": false,
      "max_points": null,
      "selection_enabled": true,
      "selection_column": "sample",
      "font_scale": null,
      "wf_tag": "nextflow/viralrecon"
