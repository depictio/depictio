      "dict_kwargs": {},
      "mode": "code",
      "code_content": "# Depth against 10x breadth, one point per sample: by lineage, or by\n# Analysis mode's groups when it has some. Depth on a log axis: samples\n# of one run span orders of magnitude. The dashed line is the 80% breadth\n# floor of the bars below.\nkw = depictio_group_kwargs or {'color': 'lineage', 'color_discrete_map': depictio_category_colors.get('lineage') or {}}\nfig = px.scatter(df.to_pandas(), x='coverage_median', y='pct_genome_covered_10x', log_x=True, hover_data=['sample', 'num_variants_total'], labels={'coverage_median': 'Median depth', 'pct_genome_covered_10x': 'Genome at 10x (%)', 'lineage': 'Lineage', 'num_variants_total': 'Variants called'}, **kw)\nfig.update_traces(marker=dict(size=10))\nfig.add_hline(y=80, line_dash='dash')\nfig.update_yaxes(range=[0, 105])\nfig.update_layout(margin=dict(t=10))",
