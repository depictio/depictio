      "code_content": "# Samples ordered by 10x breadth. The order is pinned on the axis:\n# plotly regroups categories by trace otherwise, which breaks the sort.\norder = df.sort('pct_genome_covered_10x', descending=True, nulls_last=True)['sample'].to_list()\nd = df.select('sample', 'pct_genome_covered_1x', 'pct_genome_covered_10x').unpivot(index='sample', variable_name='depth', value_name='breadth').with_columns(pl.col('depth').replace({'pct_genome_covered_1x': 'at 1x', 'pct_genome_covered_10x': 'at 10x'}))\nfig = px.bar(d.to_pandas(), x='sample', y='breadth', color='depth', barmode='group', labels={'sample': 'Sample', 'breadth': 'Genome covered (%)', 'depth': 'Depth'})\n# 80%: the template's breadth floor for a usable consensus.\nfig.add_hline(y=80, line_dash='dash', annotation_text='80%')\nfig.update_xaxes(tickangle=-45, tickfont={'size': 9}, categoryorder='array', categoryarray=order)\nfig.update_layout(margin=dict(t=10))",
