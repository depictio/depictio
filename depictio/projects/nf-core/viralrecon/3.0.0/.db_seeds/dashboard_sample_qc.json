      "code_content": "# Samples ordered by 10x breadth. The order is pinned on the axis:\n# plotly regroups categories by trace otherwise, which breaks the sort.\norder = df.sort('pct_genome_covered_10x', descending=True, nulls_last=True)['sample'].to_list()\ndf_long = df.select('sample', 'pct_genome_covered_1x', 'pct_genome_covered_10x').unpivot(\n    index='sample', variable_name='depth', value_name='breadth',\n).with_columns(\n    pl.col('depth').replace({'pct_genome_covered_1x': 'at 1x', 'pct_genome_covered_10x': 'at 10x'})\n)\nfig = px.bar(\n    df_long.to_pandas(), x='sample', y='breadth', color='depth', barmode='group',\n    labels={'sample': 'Sample', 'breadth': 'Genome covered (%)', 'depth': 'Depth'},\n)\n# 80%: the template's default breadth floor, the same value as the\n# threshold on the Genome at 10x card.\nfig.add_hline(y=80, line_dash='dash', annotation_text='80% floor')\nfig.update_xaxes(tickangle=-45, tickfont={'size': 9}, categoryorder='array', categoryarray=order)\n",
