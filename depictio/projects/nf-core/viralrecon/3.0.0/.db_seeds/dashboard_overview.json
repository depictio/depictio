      "section": "Findings",
      "visu_type": "line",
      "dict_kwargs": {},
      "mode": "code",
      "code_content": "# Median depth of each amplicon over the samples in view, along the genome,\n# one line per Analysis mode group when it has some. Floored at 1x for the\n# log axis; the dashed line is the 10x the consensus needs.\nd = df.group_by([*depictio_group_by, 'region', 'start']).agg(pl.col('coverage').median().alias('depth')).sort('start')\nd = d.with_columns(pl.col('depth').clip(lower_bound=1))\nfig = px.line(d.to_pandas(), x='start', y='depth', hover_data=['region'], markers=True, log_y=True, labels={'start': 'Genome position', 'depth': 'Median depth', 'region': 'Amplicon'}, **depictio_group_kwargs)\nfig.add_hline(y=10, line_dash='dash')\n# One tick per power of ten: a log axis otherwise labels 2 and 5 between.\nfig.update_yaxes(dtick=1)\nfig.update_layout(margin=dict(t=10))",
