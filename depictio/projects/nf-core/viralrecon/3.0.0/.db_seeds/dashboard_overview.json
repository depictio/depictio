          }
        },
        "n_cons": {
          "dc": "nextclade_results",
          "column": "sample",
          "aggregation": "count",
          "format": "integer",
          "wf_id": {
            "$oid": "746b0f3c1e4a2d7f8e5b9c01"
          },
          "dc_id": {
            "$oid": "746b0f3c1e4a2d7f8e5b9c15"
          }
        },
        "n_low": {
          "dc": "mosdepth_amplicon_coverage",
          "column": "region",
          "aggregation": "nunique",
          "filter_expr": "col('coverage') < 10",
          "format": "integer",
          "wf_id": {
