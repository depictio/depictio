      "code_content": "# Samples per Pangolin lineage: the eight largest, the rest folded into\n# Other, in the family's lineage colours.\nd = df.filter(pl.col('lineage').is_not_null()).group_by('lineage').agg(pl.len().alias('samples')).sort(['samples', 'lineage'], descending=[True, False])\ntop = d['lineage'].head(8).to_list()\nd = d.with_columns(pl.when(pl.col('lineage').is_in(top)).then(pl.col('lineage')).otherwise(pl.lit('Other')).alias('lineage')).group_by('lineage').agg(pl.col('samples').sum()).sort('samples', descending=True)\nfig = px.bar(d.to_pandas(), x='lineage', y='samples', color='lineage', color_discrete_map=depictio_category_colors.get('lineage') or {}, labels={'lineage': 'Pangolin lineage', 'samples': 'Samples'})\nfig.update_layout(showlegend=False, margin=dict(t=10))\n# A count axis in whole steps: a short one otherwise ticks 0.5.\nfig.update_yaxes(dtick=max(1, round((d['samples'].max() or 0) / 5)))",
