      "cols_json": {},
      "parent_index": null,
      "last_updated": "2026-08-29T00:00:00.000000",
      "title_align": "left",
      "section": "Typing at a glance",
      "order": 2,
      "alignment": "left",
      "vertical_alignment": "center",
      "body": "[Pangolin](https://github.com/cov-lineages/pangolin) assigns a lineage, [Nextclade](https://github.com/nextstrain/nextclade) assigns a clade and scores the consensus it was called from. They disagree usefully: a confident lineage on a consensus Nextclade marks as bad is a call to distrust, and the two QC selectors on the left are there to isolate exactly that case.",
      "wf_tag": "nextflow/viralrecon"
    },
