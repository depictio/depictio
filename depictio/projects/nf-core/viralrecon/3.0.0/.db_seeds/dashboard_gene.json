      "section": "Mutations in the gene",
      "visu_type": "scatter",
      "dict_kwargs": {},
      "mode": "code",
      "code_content": "# Allele frequency of every call of the gene, one dot per call, samples\n# ordered by their best supported call. The colour is the snpEff effect, or\n# Analysis mode's groups when it has some; the dashed line is the 0.75\n# consensus cut-off. custom_data carries the sample the selection reads.\nd = df.filter(pl.col('AF').is_not_null())\norder = d.group_by('sample').agg(pl.col('AF').max().alias('top')).sort('top', descending=True)['sample'].to_list()\nkw = depictio_group_kwargs or {'color': 'EFFECT', 'color_discrete_map': depictio_category_colors.get('EFFECT') or {}}\nfig = px.scatter(d.to_pandas(), x='sample', y='AF', custom_data=['sample'], hover_name='mutation_label', labels={'sample': 'Sample', 'AF': 'Allele frequency', 'EFFECT': 'Effect'}, **kw)\nfig.update_traces(marker=dict(size=12))\nfig.add_hline(y=0.75, line_dash='dash')\nfig.update_xaxes(tickangle=-45, tickfont={'size': 9}, categoryorder='array', categoryarray=order)\nfig.update_yaxes(range=[0, 1.05])\nfig.update_layout(showlegend=False, margin=dict(t=10))",
      "displayed_data_count": 0,
      "total_data_count": 0,
