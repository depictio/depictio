{
  "$defs": {
    "ChangelogEntry": {
      "additionalProperties": false,
      "description": "One revision of a module: its version and what changed in it.",
      "properties": {
        "version": {
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Version",
          "type": "string"
        },
        "date": {
          "anyOf": [
            {
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Date"
        },
        "changes": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Changes",
          "type": "array"
        }
      },
      "required": [
        "version",
        "changes"
      ],
      "title": "ChangelogEntry",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A tool. Identity is stored as directly-clickable URLs.",
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "version": {
      "default": "1.0.0",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Version",
      "type": "string"
    },
    "changelog": {
      "items": {
        "$ref": "#/$defs/ChangelogEntry"
      },
      "title": "Changelog",
      "type": "array"
    },
    "description": {
      "default": "",
      "title": "Description",
      "type": "string"
    },
    "homepage": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Homepage"
    },
    "source_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Url"
    },
    "nf_core_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Nf Core Url"
    },
    "biotools_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Biotools Url"
    },
    "edam_topics": {
      "items": {
        "type": "string"
      },
      "title": "Edam Topics",
      "type": "array"
    },
    "stage": {
      "anyOf": [
        {
          "enum": [
            "qc",
            "alignment",
            "quantification",
            "peaks",
            "variants",
            "fusions",
            "taxonomy",
            "annotation",
            "immune",
            "differential",
            "benchmarking",
            "other"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Stage"
    }
  },
  "required": [
    "id",
    "name"
  ],
  "title": "CatalogTool",
  "type": "object"
}
