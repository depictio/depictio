{
  "$defs": {
    "AggFn": {
      "description": "Closed allowlist of ``group_by().agg()`` reducers.",
      "enum": [
        "sum",
        "mean",
        "median",
        "min",
        "max",
        "count",
        "len",
        "nunique",
        "std",
        "var",
        "first",
        "last"
      ],
      "title": "AggFn",
      "type": "string"
    },
    "AggSpec": {
      "additionalProperties": false,
      "description": "One reducer of a ``group_by().agg()``.\n\n``col`` is null only for ``fn == \"len\"`` spelled bare (``pl.len()`` /\nthe deprecated ``pl.count()``): the group size reads no column. The\ncolumn-attached spelling ``pl.col(c).len()`` keeps ``col = c`` \u2014 Polars\nstill returns the group size there, but names the output after ``c``, and\na missing ``c`` still raises.",
      "properties": {
        "col": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Source column reduced; null only for a bare ``len`` (group size)",
          "title": "Col"
        },
        "fn": {
          "$ref": "#/$defs/AggFn"
        },
        "alias": {
          "description": "Output column name. Polars defaults it to ``col``, except for a bare ``pl.len()`` -> 'len' and a bare ``pl.count()`` -> 'count'",
          "title": "Alias",
          "type": "string"
        }
      },
      "required": [
        "fn",
        "alias"
      ],
      "title": "AggSpec",
      "type": "object"
    },
    "AndPred": {
      "additionalProperties": false,
      "description": "``{\"and\": [<Pred>, ...]}`` \u2014 the field is aliased because ``and`` is a keyword.",
      "properties": {
        "and": {
          "description": "Conjuncts, evaluated left to right",
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/CmpPred"
              },
              {
                "$ref": "#/$defs/IsNullPred"
              },
              {
                "$ref": "#/$defs/IsNotNullPred"
              },
              {
                "$ref": "#/$defs/IsInPred"
              },
              {
                "$ref": "#/$defs/AndPred"
              },
              {
                "$ref": "#/$defs/OrPred"
              },
              {
                "$ref": "#/$defs/NotPred"
              }
            ]
          },
          "title": "And",
          "type": "array"
        }
      },
      "required": [
        "and"
      ],
      "title": "AndPred",
      "type": "object"
    },
    "BindingTable": {
      "additionalProperties": false,
      "description": "Everything the runtime needs to refill a ui-mode figure (RFC \u00a74).",
      "properties": {
        "scaffold": {
          "additionalProperties": true,
          "description": "Full figure JSON from the real create_figure_from_data, data arrays stripped",
          "title": "Scaffold",
          "type": "object"
        },
        "group_cols": {
          "description": "px grouping columns in order [color, symbol, line_dash, line_group, pattern_shape, facet_row, facet_col]",
          "items": {
            "type": "string"
          },
          "title": "Group Cols",
          "type": "array"
        },
        "traces": {
          "items": {
            "$ref": "#/$defs/TraceBinding"
          },
          "title": "Traces",
          "type": "array"
        },
        "trendlines": {
          "items": {
            "$ref": "#/$defs/TrendlineBinding"
          },
          "title": "Trendlines",
          "type": "array"
        },
        "sampled": {
          "default": false,
          "description": "True when the build sampled before filtering (FIGURE_MAX_POINTS) -> partial tier",
          "title": "Sampled",
          "type": "boolean"
        }
      },
      "required": [
        "scaffold",
        "traces"
      ],
      "title": "BindingTable",
      "type": "object"
    },
    "BundleMode": {
      "description": "Delivery mode \u2014 only ``data_refs[].uri`` semantics change between them.",
      "enum": [
        "single-file",
        "static-dir",
        "remote"
      ],
      "title": "BundleMode",
      "type": "string"
    },
    "CmpArgs": {
      "additionalProperties": false,
      "description": "Argument of ``cmp``: column, operator, literal.",
      "properties": {
        "col": {
          "title": "Col",
          "type": "string"
        },
        "op": {
          "$ref": "#/$defs/CmpOperator"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "boolean"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            }
          ],
          "description": "JSON scalar compared against the column (never null \u2014 use is_null)",
          "title": "Value"
        }
      },
      "required": [
        "col",
        "op",
        "value"
      ],
      "title": "CmpArgs",
      "type": "object"
    },
    "CmpOperator": {
      "description": "Comparison operators expressible in a prologue predicate.",
      "enum": [
        "<",
        "<=",
        ">",
        ">=",
        "==",
        "!="
      ],
      "title": "CmpOperator",
      "type": "string"
    },
    "CmpPred": {
      "additionalProperties": false,
      "description": "``{\"cmp\": {\"col\": \"q_val\", \"op\": \"<\", \"value\": 0.05}}``",
      "properties": {
        "cmp": {
          "$ref": "#/$defs/CmpArgs"
        }
      },
      "required": [
        "cmp"
      ],
      "title": "CmpPred",
      "type": "object"
    },
    "ColRef": {
      "additionalProperties": false,
      "description": "Argument of the unary null predicates: ``{\"col\": \"x\"}``.",
      "properties": {
        "col": {
          "description": "Column the predicate tests",
          "title": "Col",
          "type": "string"
        }
      },
      "required": [
        "col"
      ],
      "title": "ColRef",
      "type": "object"
    },
    "ColumnSpec": {
      "additionalProperties": false,
      "description": "One physical column of a bundled Parquet file.",
      "properties": {
        "name": {
          "description": "Column name as stored in the Parquet file",
          "title": "Name",
          "type": "string"
        },
        "dtype": {
          "description": "Polars dtype string at export time (e.g. 'Int64', 'Utf8')",
          "title": "Dtype",
          "type": "string"
        }
      },
      "required": [
        "name",
        "dtype"
      ],
      "title": "ColumnSpec",
      "type": "object"
    },
    "ComponentTier": {
      "description": "Per-component liveness in the static runtime (RFC \u00a73.2).",
      "enum": [
        "live",
        "partial",
        "frozen",
        "omitted"
      ],
      "title": "ComponentTier",
      "type": "string"
    },
    "DashboardSection": {
      "additionalProperties": false,
      "description": "The dashboard document the runtime mounts.",
      "properties": {
        "id": {
          "description": "Dashboard id the runtime passes to App \u2014 real Mongo id (producer A/C) or synthetic sha1(workflow_tag + ':' + dc_tag)[:24]-style id (producer B). Must be non-empty: ComponentRenderer silently no-ops several component types without a dashboardId.",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "default": "",
          "title": "Title",
          "type": "string"
        },
        "doc": {
          "additionalProperties": true,
          "description": "DashboardDataLite-shaped document: layout + stored_metadata components",
          "title": "Doc",
          "type": "object"
        }
      },
      "required": [
        "id",
        "doc"
      ],
      "title": "DashboardSection",
      "type": "object"
    },
    "DataRef": {
      "additionalProperties": false,
      "description": "One data collection's bundled table.\n\nMirrors the shape of ``load_deltatable_lite``'s ``init_data`` entries\n(``deltatables_utils.py:1393``) \u2014 the proven \"resolve a DC without an API\nround-trip\" contract \u2014 extended with serverless-only fields.",
      "properties": {
        "uri": {
          "description": "Where the Parquet bytes live. 'inline:dc_<id>' (single-file, resolved against inline_blobs), a bundle-relative path like 'data/<id>.parquet' (static-dir), or an absolute URL (remote). All resolution goes through the runtime's single resolveUri() helper.",
          "title": "Uri",
          "type": "string"
        },
        "rows": {
          "description": "Row count at export time",
          "minimum": 0,
          "title": "Rows",
          "type": "integer"
        },
        "size_bytes": {
          "description": "Parquet file size in bytes",
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "row_group_bytes": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Target row-group size used at export (tuned for Range requests in remote mode)",
          "title": "Row Group Bytes"
        },
        "columns": {
          "description": "Physical schema after pruning + companions",
          "items": {
            "$ref": "#/$defs/ColumnSpec"
          },
          "title": "Columns",
          "type": "array"
        },
        "companions": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Companion column name -> source. '__ts__<col>': epoch-microsecond datetime companion for <col>; '__fe__<sha8>': boolean column for the component-static filter_expr whose source text is the value; '__code__<col>': Int32 codebook codes for categorical column <col>.",
          "title": "Companions",
          "type": "object"
        },
        "codebooks": {
          "additionalProperties": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object"
          },
          "description": "Per categorical non-String column: JSON-serialized option value -> integer code stored in the '__code__<col>' companion. Keys are serialized with the same _json_safe path that produces MultiSelect options, so option values and codebook keys are byte-identical. A selected value absent from the codebook matches nothing (same as a failed cast server-side).",
          "title": "Codebooks",
          "type": "object"
        },
        "aggregation_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Staleness token: server-side _get_aggregation_hash for producer A, hash of the input Parquet bytes for producer B",
          "title": "Aggregation Hash"
        }
      },
      "required": [
        "uri",
        "rows",
        "size_bytes",
        "columns"
      ],
      "title": "DataRef",
      "type": "object"
    },
    "FilterOp": {
      "additionalProperties": false,
      "description": "``df.filter(<pred>)`` \u2014 row selection. Nulls never match.",
      "properties": {
        "op": {
          "const": "filter",
          "default": "filter",
          "title": "Op",
          "type": "string"
        },
        "pred": {
          "anyOf": [
            {
              "$ref": "#/$defs/CmpPred"
            },
            {
              "$ref": "#/$defs/IsNullPred"
            },
            {
              "$ref": "#/$defs/IsNotNullPred"
            },
            {
              "$ref": "#/$defs/IsInPred"
            },
            {
              "$ref": "#/$defs/AndPred"
            },
            {
              "$ref": "#/$defs/OrPred"
            },
            {
              "$ref": "#/$defs/NotPred"
            }
          ],
          "title": "Pred"
        }
      },
      "required": [
        "pred"
      ],
      "title": "FilterOp",
      "type": "object"
    },
    "FrozenPayload": {
      "additionalProperties": false,
      "description": "A precomputed component payload, rendered when the component is frozen.",
      "properties": {
        "kind": {
          "description": "Component type the payload feeds (figure|table|card|multiqc|advanced_viz|map|image)",
          "title": "Kind",
          "type": "string"
        },
        "payload": {
          "additionalProperties": true,
          "description": "Exactly what the corresponding api.ts function would have returned",
          "title": "Payload",
          "type": "object"
        },
        "filter_state": {
          "description": "Filter state the payload was computed at (default state = [])",
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Filter State",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "payload"
      ],
      "title": "FrozenPayload",
      "type": "object"
    },
    "GroupByOp": {
      "additionalProperties": false,
      "description": "``df.group_by(by, maintain_order=True).agg(...)`` \u2014 first-appearance group order.",
      "properties": {
        "op": {
          "const": "group_by",
          "default": "group_by",
          "title": "Op",
          "type": "string"
        },
        "by": {
          "description": "Grouping key columns; a null key forms its own group",
          "items": {
            "type": "string"
          },
          "title": "By",
          "type": "array"
        },
        "agg": {
          "items": {
            "$ref": "#/$defs/AggSpec"
          },
          "title": "Agg",
          "type": "array"
        }
      },
      "required": [
        "by",
        "agg"
      ],
      "title": "GroupByOp",
      "type": "object"
    },
    "IsInArgs": {
      "additionalProperties": false,
      "description": "Argument of ``is_in``: column plus the literal membership set.",
      "properties": {
        "col": {
          "title": "Col",
          "type": "string"
        },
        "values": {
          "description": "Literal scalars the column must be one of",
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "boolean"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              }
            ]
          },
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "col",
        "values"
      ],
      "title": "IsInArgs",
      "type": "object"
    },
    "IsInPred": {
      "additionalProperties": false,
      "description": "``{\"is_in\": {\"col\": \"x\", \"values\": [...]}}``",
      "properties": {
        "is_in": {
          "$ref": "#/$defs/IsInArgs"
        }
      },
      "required": [
        "is_in"
      ],
      "title": "IsInPred",
      "type": "object"
    },
    "IsNotNullPred": {
      "additionalProperties": false,
      "description": "``{\"is_not_null\": {\"col\": \"x\"}}``",
      "properties": {
        "is_not_null": {
          "$ref": "#/$defs/ColRef"
        }
      },
      "required": [
        "is_not_null"
      ],
      "title": "IsNotNullPred",
      "type": "object"
    },
    "IsNullPred": {
      "additionalProperties": false,
      "description": "``{\"is_null\": {\"col\": \"x\"}}``",
      "properties": {
        "is_null": {
          "$ref": "#/$defs/ColRef"
        }
      },
      "required": [
        "is_null"
      ],
      "title": "IsNullPred",
      "type": "object"
    },
    "LinkTable": {
      "additionalProperties": false,
      "description": "Precomputed value-mapping for a DC link whose source DC is not bundled (tier B).",
      "properties": {
        "values": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "description": "Source value -> translated target values",
          "title": "Values",
          "type": "object"
        }
      },
      "title": "LinkTable",
      "type": "object"
    },
    "LinksSection": {
      "additionalProperties": false,
      "description": "DC link configs plus precomputed translation tables (RFC \u00a78).",
      "properties": {
        "configs": {
          "description": "Link configs as stored in Mongo, verbatim",
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Configs",
          "type": "array"
        },
        "tables": {
          "additionalProperties": {
            "$ref": "#/$defs/LinkTable"
          },
          "description": "link_id -> precomputed translation table",
          "title": "Tables",
          "type": "object"
        }
      },
      "title": "LinksSection",
      "type": "object"
    },
    "NotPred": {
      "additionalProperties": false,
      "description": "``{\"not\": <Pred>}``",
      "properties": {
        "not": {
          "anyOf": [
            {
              "$ref": "#/$defs/CmpPred"
            },
            {
              "$ref": "#/$defs/IsNullPred"
            },
            {
              "$ref": "#/$defs/IsNotNullPred"
            },
            {
              "$ref": "#/$defs/IsInPred"
            },
            {
              "$ref": "#/$defs/AndPred"
            },
            {
              "$ref": "#/$defs/OrPred"
            },
            {
              "$ref": "#/$defs/NotPred"
            }
          ],
          "description": "Negated sub-predicate",
          "title": "Not"
        }
      },
      "required": [
        "not"
      ],
      "title": "NotPred",
      "type": "object"
    },
    "OrPred": {
      "additionalProperties": false,
      "description": "``{\"or\": [<Pred>, ...]}``",
      "properties": {
        "or": {
          "description": "Disjuncts, evaluated left to right",
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/CmpPred"
              },
              {
                "$ref": "#/$defs/IsNullPred"
              },
              {
                "$ref": "#/$defs/IsNotNullPred"
              },
              {
                "$ref": "#/$defs/IsInPred"
              },
              {
                "$ref": "#/$defs/AndPred"
              },
              {
                "$ref": "#/$defs/OrPred"
              },
              {
                "$ref": "#/$defs/NotPred"
              }
            ]
          },
          "title": "Or",
          "type": "array"
        }
      },
      "required": [
        "or"
      ],
      "title": "OrPred",
      "type": "object"
    },
    "Producer": {
      "description": "Which producer built the bundle (RFC \u00a73.3).",
      "enum": [
        "A",
        "B",
        "C"
      ],
      "title": "Producer",
      "type": "string"
    },
    "RenameOp": {
      "additionalProperties": false,
      "description": "``df.rename({\"old\": \"new\"})``.",
      "properties": {
        "op": {
          "const": "rename",
          "default": "rename",
          "title": "Op",
          "type": "string"
        },
        "map": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Old column name -> new column name",
          "title": "Map",
          "type": "object"
        }
      },
      "required": [
        "map"
      ],
      "title": "RenameOp",
      "type": "object"
    },
    "RuntimeLimits": {
      "additionalProperties": false,
      "description": "Sampling ceilings the runtime enforces, pinned from the building instance.\n\nMirrors ``PerformanceConfig`` (settings_models.py): the advanced_viz data\npath reduces the filtered frame to ``figure_max_points`` rows under the\nkind's policy, and flags aggregating kinds as degraded past\n``advanced_viz_no_sample_max_rows``. Defaults match the server defaults so\nmanifests built before this field existed keep the same behaviour.",
      "properties": {
        "figure_max_points": {
          "default": 10000,
          "description": "Scan-level reduction cap (rows) for sampled render paths",
          "title": "Figure Max Points",
          "type": "integer"
        },
        "advanced_viz_no_sample_max_rows": {
          "default": 2000000,
          "description": "Ceiling past which 'none'-policy kinds are sampled anyway (degraded); 0 disables",
          "title": "Advanced Viz No Sample Max Rows",
          "type": "integer"
        },
        "advanced_viz_tail_p_threshold": {
          "default": 0.05,
          "description": "Fallback tail threshold for raw p-value columns",
          "title": "Advanced Viz Tail P Threshold",
          "type": "number"
        },
        "advanced_viz_tail_effect_threshold": {
          "default": 1.0,
          "description": "Fallback tail threshold for signed effect columns",
          "title": "Advanced Viz Tail Effect Threshold",
          "type": "number"
        }
      },
      "title": "RuntimeLimits",
      "type": "object"
    },
    "SortOp": {
      "additionalProperties": false,
      "description": "``df.sort(by, descending=desc)`` with Polars' default null placement.",
      "properties": {
        "op": {
          "const": "sort",
          "default": "sort",
          "title": "Op",
          "type": "string"
        },
        "by": {
          "items": {
            "type": "string"
          },
          "title": "By",
          "type": "array"
        },
        "desc": {
          "description": "Per-key direction; same length as ``by``",
          "items": {
            "type": "boolean"
          },
          "title": "Desc",
          "type": "array"
        }
      },
      "required": [
        "by",
        "desc"
      ],
      "title": "SortOp",
      "type": "object"
    },
    "TierEntry": {
      "additionalProperties": false,
      "description": "Per-component liveness verdict, shown by ``--check`` and the runtime badge.",
      "properties": {
        "tier": {
          "$ref": "#/$defs/ComponentTier"
        },
        "reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/TierReason"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Machine-readable cause when tier != live"
        },
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Human string for the --check table and badge tooltip",
          "title": "Detail"
        }
      },
      "required": [
        "tier"
      ],
      "title": "TierEntry",
      "type": "object"
    },
    "TierReason": {
      "description": "Why a component is not fully live. ``detail`` carries the human string.",
      "enum": [
        "multiqc",
        "celery_compute",
        "code_mode",
        "binding_miss",
        "max_points",
        "link_table_too_big",
        "map_tiles",
        "jbrowse",
        "image",
        "whole_frame_viz",
        "filter_expr_window",
        "unsupported"
      ],
      "title": "TierReason",
      "type": "string"
    },
    "TraceBinding": {
      "additionalProperties": false,
      "description": "One trace's binding in the bind-and-refill scheme (RFC \u00a74).",
      "properties": {
        "i": {
          "description": "Trace index in the scaffold figure",
          "minimum": 0,
          "title": "I",
          "type": "integer"
        },
        "group": {
          "additionalProperties": true,
          "description": "Equality predicates (grouping column -> value) selecting this trace's rows",
          "title": "Group",
          "type": "object"
        },
        "fields": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Trace field path (e.g. 'x', 'y', 'marker.size') -> source column",
          "title": "Fields",
          "type": "object"
        },
        "axes": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Facet-cell disambiguation: 'xaxis'/'yaxis' -> plotly axis id",
          "title": "Axes",
          "type": "object"
        }
      },
      "required": [
        "i",
        "fields"
      ],
      "title": "TraceBinding",
      "type": "object"
    },
    "TrendlineBinding": {
      "additionalProperties": false,
      "description": "A trendline trace refit client-side via closed-form 1-predictor OLS.",
      "properties": {
        "i": {
          "description": "Trendline trace index in the scaffold",
          "minimum": 0,
          "title": "I",
          "type": "integer"
        },
        "on": {
