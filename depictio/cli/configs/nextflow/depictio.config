/*
 * ============================================================================
 *  Depictio: automatic ingestion when a Nextflow pipeline completes
 * ============================================================================
 *
 *  Drop-in config snippet. When the pipeline finishes *successfully* it runs
 *  `depictio-cli run` on the output directory, so the results land in a
 *  Depictio instance without anyone typing a command.
 *
 *  Use it for a single run:
 *      nextflow run <pipeline> -c /path/to/depictio.config
 *
 *  Or permanently, from your own nextflow.config:
 *      includeConfig '/path/to/depictio.config'
 *
 *  Requirements:
 *    * `depictio-cli` must be installed and on the PATH of the *Nextflow head
 *      job*: the shell or scheduler job that runs `nextflow run`. The handler
 *      below executes there, never on a compute node.
 *    * The head job must reach the Depictio API and carry credentials, either
 *      through a CLI config file or through the environment variables
 *      DEPICTIO_CLI_TOKEN, DEPICTIO_CLI_API_BASE_URL and
 *      DEPICTIO_CLI_CONFIG_PATH.
 *
 *  Everything here is best effort. A missing CLI, an unreachable server or a
 *  failed ingestion logs a warning and never changes the pipeline's own exit
 *  status. The handler is additive: it does not replace a pipeline's own
 *  workflow.onComplete.
 *
 *  Parameters (all optional; override with --<name>, a params file, or your
 *  own config):
 *
 *    depictio_enabled          true           set to false to disable the trigger
 *    depictio_data_root        params.outdir  directory to ingest
 *    depictio_cli_config       see below      path to the Depictio CLI config
 *    depictio_template         null           explicit Depictio template id
 *    depictio_project_config   null           Depictio project YAML (wins over the template)
 *    depictio_project          null           target project name
 *    depictio_attach           false          add this run to an existing project
 *    depictio_update           false          re-ingest into an existing project
 *    depictio_user             null           provision this user and run as them
 *    depictio_cli_executable   depictio-cli   CLI name, absolute path, or a list
 *                                             (a container invocation)
 *
 *  depictio_cli_config defaults to $DEPICTIO_CLI_CONFIG_PATH when that variable
 *  is set, otherwise to ~/.depictio/CLI.yaml.
 * ============================================================================
 */

// ----------------------------------------------------------------------------
// Defaults.
//
// Include order and `-c` precedence are not predictable, so every default is
// written as "keep what is already there, otherwise use mine". That way this
// file can be included before or after the values it defaults, and a
// command-line --depictio_* always wins.
// ----------------------------------------------------------------------------

params.depictio_enabled = (params.containsKey('depictio_enabled')
    ? params.depictio_enabled
    : true)

// Left null on purpose: params.outdir is read at completion time, when the
// final merged params are known, rather than at config-parse time.
params.depictio_data_root = (params.containsKey('depictio_data_root')
    ? params.depictio_data_root
    : null)

params.depictio_cli_config = (params.containsKey('depictio_cli_config')
    ? params.depictio_cli_config
    : (System.getenv('DEPICTIO_CLI_CONFIG_PATH')
        ?: "${System.getProperty('user.home')}/.depictio/CLI.yaml"))

params.depictio_template = (params.containsKey('depictio_template')
    ? params.depictio_template
    : null)

params.depictio_project_config = (params.containsKey('depictio_project_config')
    ? params.depictio_project_config
    : null)

params.depictio_project = (params.containsKey('depictio_project')
    ? params.depictio_project
    : null)

params.depictio_attach = (params.containsKey('depictio_attach')
    ? params.depictio_attach
    : false)

// A re-run of the same pipeline finds its project already on the server. Without
// this the CLI refuses to touch it, which is the safe default but stops every
// second execution; set it to update the project in place instead.
params.depictio_update = (params.containsKey('depictio_update')
    ? params.depictio_update
    : false)

params.depictio_user = (params.containsKey('depictio_user')
    ? params.depictio_user
    : null)

params.depictio_cli_executable = (params.containsKey('depictio_cli_executable')
    ? params.depictio_cli_executable
    : 'depictio-cli')

// ----------------------------------------------------------------------------
// Completion handler.
//
// Written without helper closures on purpose: the strict Nextflow config parser
// (25.10+) rejects a locally defined closure invoked as `helper(...)`, so the
// repeated string and boolean handling below is spelled out inline.
// ----------------------------------------------------------------------------

workflow.onComplete = {
    // A handler defined in a config file does not get the script-level `log`
    // binding (it resolves to null), so bind a logger explicitly. The
    // `nextflow.` prefix is what puts the messages on the console as well as in
    // .nextflow.log; a logger named outside that namespace only reaches the file.
    def log = org.slf4j.LoggerFactory.getLogger('nextflow.depictio')

    try {
        // Nextflow passes booleans through as-is, but `--depictio_enabled false`
        // and params files deliver strings, and every non-empty string is truthy
        // in Groovy. Compare against the falsy spellings explicitly.
        def enabledRaw = params.depictio_enabled
        def enabled = (enabledRaw instanceof Boolean)
            ? enabledRaw
            : !(enabledRaw == null
                || enabledRaw.toString().trim().toLowerCase() in ['false', '0', 'no', 'off', ''])
        if (!enabled) {
            return
        }

        // Never ingest the output of a failed pipeline: it is partial by
        // definition, and a half-filled project is worse than no project.
        if (!workflow.success) {
            log.warn("[depictio] Pipeline did not complete successfully, skipping ingestion.")
            return
        }

        def dataRoot = (params.depictio_data_root ?: params.outdir)?.toString()?.trim()
        if (!dataRoot) {
            log.warn("[depictio] No data root to ingest: set params.depictio_data_root " +
                "or params.outdir. Skipping ingestion.")
            return
        }
        // The CLI reads from a local filesystem and the project YAML may
        // interpolate this path, so hand it an absolute one. Leave URIs alone.
        if (!dataRoot.contains('://') && !dataRoot.startsWith('/')) {
            dataRoot = new File(workflow.launchDir.toString(), dataRoot).absolutePath
        }

        // Accepting a list is what lets the published container be used without
        // inventing a second parameter. The image sets depictio-cli as its
        // entrypoint, so the list stops at the image name:
        //   ['docker', 'run', '--rm', '-v', "${dir}:${dir}",
        //    'ghcr.io/depictio/depictio-cli:1.9.2']
        // A plain string stays the common case: a name on PATH, or a path.
        def executableRaw = params.depictio_cli_executable
        def argv = []
        if (executableRaw instanceof List) {
            argv.addAll(executableRaw.collect { it.toString() })
        }
        else {
            argv.add(executableRaw?.toString()?.trim() ?: 'depictio-cli')
        }
        argv.add('run')

        def cliConfig = params.depictio_cli_config?.toString()?.trim()
        if (cliConfig) {
            if (cliConfig.startsWith('~/')) {
                cliConfig = System.getProperty('user.home') + cliConfig.substring(1)
            }
            argv += ['--CLI-config-path', cliConfig]
        }

        argv += ['--data-root', dataRoot]

        // An explicit project YAML beats a template: it is the escape hatch for
        // pipelines Depictio ships no template for.
        def projectConfig = params.depictio_project_config?.toString()?.trim()
        def template = params.depictio_template?.toString()?.trim()
        if (projectConfig) {
            if (projectConfig.startsWith('~/')) {
                projectConfig = System.getProperty('user.home') + projectConfig.substring(1)
            }
            argv += ['--project-config-path', projectConfig]
        }
        else if (template) {
            argv += ['--template', template]
        }

        // Always forwarded when the pipeline declares a manifest. The CLI uses it
        // to resolve a bundled template only when neither --template nor
        // --project-config-path was given, and ignores it otherwise.
        def manifestName = workflow.manifest?.name?.toString()?.trim()
        if (manifestName) {
            def manifestVersion = workflow.manifest?.version?.toString()?.trim() ?: 'latest'
            argv += ['--nextflow-manifest', (manifestName + '/' + manifestVersion)]
        }

        def projectName = params.depictio_project?.toString()?.trim()
        if (projectName) {
            argv += ['--project-name', projectName]
        }

        def attachRaw = params.depictio_attach
        def attach = (attachRaw instanceof Boolean)
            ? attachRaw
            : !(attachRaw == null
                || attachRaw.toString().trim().toLowerCase() in ['false', '0', 'no', 'off', ''])
        if (attach) {
            argv += ['--attach-run']
        }

        // --attach-run already implies both of these, so only add them on their own.
        // --overwrite comes along because refreshing a project whose delta tables
        // are already written is the whole point: without it every data collection
        // fails with "already exists, use update=True to update it".
        def updateRaw = params.depictio_update
        def update = (updateRaw instanceof Boolean)
            ? updateRaw
            : !(updateRaw == null
                || updateRaw.toString().trim().toLowerCase() in ['false', '0', 'no', 'off', ''])
        if (update && !attach) {
            argv += ['--update-config', '--overwrite']
        }

        def userEmail = params.depictio_user?.toString()?.trim()
        if (userEmail) {
            argv += ['--user', userEmail]
        }

        log.info("[depictio] Ingesting ${dataRoot}")
        log.info("[depictio] " + argv.join(' '))

        def pb = new ProcessBuilder(argv)
        pb.redirectErrorStream(true)
        pb.directory(new File(workflow.launchDir.toString()))
        // Exported so a generic project YAML can point its data_location at
        // {DEPICTIO_DATA_ROOT} instead of hardcoding an output directory.
        pb.environment().put('DEPICTIO_DATA_ROOT', dataRoot)

        def proc = pb.start()
        // Drain the merged stdout/stderr *before* waitFor(). Waiting first would
        // deadlock as soon as the CLI fills the OS pipe buffer, and the head job
        // would hang after the pipeline is otherwise done.
        proc.inputStream.eachLine { line -> log.info("[depictio] " + line) }
        def exitCode = proc.waitFor()

        if (exitCode != 0) {
            log.warn("[depictio] depictio-cli exited with code ${exitCode}; results were not " +
                "ingested. The pipeline result is unchanged.")
        }
        else {
            log.info("[depictio] Ingestion finished for ${dataRoot}")
        }
    }
    catch (Throwable t) {
        // Deliberately swallowed: the pipeline succeeded, and a broken Depictio
        // trigger must not turn that into a failure.
        log.warn("[depictio] Ingestion trigger failed, pipeline result unchanged: ${t}")
    }
}
