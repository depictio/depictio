nextflow_workflow {

    name "Test Subworkflow DEPICTIO_PUBLISH"
    script "../main.nf"
    workflow "DEPICTIO_PUBLISH"
    config "../nextflow.config"

    tag "subworkflows"
    tag "depictio"
    tag "subworkflows/depictio_publish"
    tag "depictio/ingest"

    test("results directory and samplesheet - stub") {

        options "-stub"

        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                """
                input[0] = channel.of('multiqc done')
                input[1] = "${moduleDir}/tests"
                input[2] = "${moduleDir}/meta.yml"
                input[3] = null
                input[4] = null
                input[5] = null
                input[6] = null
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.result.size() == 1 },
                { assert file(workflow.out.result[0][1]).name.endsWith('.depictio.json') },
                { assert file(workflow.out.artifact[0][1]).name.endsWith('_depictio') }
            )
        }
    }
}
