nextflow_workflow {

    name "Test Subworkflow DEPICTIO_PUBLISH"
    script "../main.nf"
    workflow "DEPICTIO_PUBLISH"
    config "../nextflow.config"

    tag "subworkflows"
    tag "depictio"
    tag "subworkflows/depictio_publish"
    tag "depictio/ingest"

    test("results directory and samplesheet - stub") {

        options "-stub"

        when {
            params {
                outdir = "$outputDir"
                depictio_id = 'run'
            }
            workflow {
                """
                input[0] = channel.of('multiqc done')
                input[1] = "${moduleDir}/tests"
                input[2] = "${moduleDir}/meta.yml"
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.result.size() == 1 },
                { assert file(workflow.out.result[0][1]).name == 'run.depictio.json' },
                { assert file(workflow.out.artifact[0][1]).name == 'run_depictio' }
            )
        }
    }
}
