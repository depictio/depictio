// Settings of the depictio/publish subworkflow. Include it from the pipeline's
// nextflow.config, after its own params block:
//
//     includeConfig 'subworkflows/depictio/publish/nextflow.config'
//
// Every setting is optional: by default the run becomes an artifact
// (results/depictio/<run>_depictio/), the template is detected from
// pipeline_info/ and its route variables from params.json. Declare the
// depictio_* params in nextflow_schema.json, or nf-schema rejects them.
params {
    depictio_template       = null   // a template id, to skip detection (nf-core/rnaseq/3.26.0)
    depictio_project_config = null   // a project YAML, for a pipeline with no template
    depictio_dashboards     = null   // dashboard YAML(s) to import as well
    depictio_cli_config     = null   // a CLI.yaml: send the run to that instance, no artifact
    depictio_project        = null   // project name (default: the template's)
    depictio_vars           = [:]    // template variables, when the run's params cannot tell
    depictio_ingest_args    = ''     // further `depictio ingest` options
    depictio_local_args     = ''     // `depictio local up` options (e.g. '--port 8123')
    depictio_id             = null   // names the outputs (default: workflow.runName)
}

process {
    withName: '.*DEPICTIO_PUBLISH:DEPICTIO_INGEST' {
        // Depictio is a report on the run, not part of it.
        errorStrategy = 'ignore'
        publishDir    = [
            path: { "${params.outdir}/depictio" },
            mode: params.containsKey('publish_dir_mode') ? params.publish_dir_mode : 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
        // Single-quoted for the task's shell (config closures take no local helpers).
        ext.args  = { [
            params.depictio_project
                ? "--project '" + params.depictio_project.toString().replace("'", "'\\''") + "'"
                : '',
            (params.depictio_vars ?: [:]).collect { k, v ->
                "--var '" + "${k}=${v}".toString().replace("'", "'\\''") + "'"
            }.join(' '),
            params.depictio_ingest_args ?: '',
        ].findAll { a -> a }.join(' ') }
        ext.args2 = { params.depictio_local_args ?: '' }
    }
}
