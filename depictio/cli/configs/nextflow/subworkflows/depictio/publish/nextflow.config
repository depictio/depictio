// The DEPICTIO_INGEST settings of the depictio/publish subworkflow. Include it
// from the pipeline's nextflow.config (or copy the block into conf/modules.config):
//
//     includeConfig 'subworkflows/local/depictio/publish/nextflow.config'
//
// It reads four optional pipeline params, declared by the pipeline (in its
// nextflow.config and nextflow_schema.json) like the others it passes to the
// subworkflow: depictio_project, depictio_vars, depictio_ingest_args and
// depictio_local_args. Unset, none is passed.
process {
    withName: '.*DEPICTIO_PUBLISH:DEPICTIO_INGEST' {
        // Depictio is a report on the run, not part of it.
        errorStrategy = 'ignore'
        publishDir    = [
            path: { "${params.outdir}/depictio" },
            mode: params.publish_dir_mode ?: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
        // Single-quoted for the task's shell (config closures take no local helpers).
        ext.args  = { [
            params.depictio_project
                ? "--project '" + params.depictio_project.toString().replace("'", "'\\''") + "'"
                : '',
            // A map in a config or params file; `K=V,K2=V2` on the command line.
            (params.depictio_vars instanceof Map
                ? params.depictio_vars.collect { k, v -> "${k}=${v}".toString() }
                : (params.depictio_vars ?: '').toString().tokenize(',')
            ).collect { kv ->
                "--var '" + kv.trim().replace("'", "'\\''") + "'"
            }.join(' '),
            params.depictio_ingest_args ?: '',
        ].findAll { a -> a }.join(' ') }
        ext.args2 = { params.depictio_local_args ?: '' }
    }
}
