manifest {
    name        = 'depictio/nextflow-trigger-example'
    version     = '0.1.0'
    description = 'Minimal pipeline demonstrating the Depictio onComplete trigger'
}

params {
    outdir = 'results'
}

// This pipeline is not an nf-core pipeline, so Depictio has no bundled template
// for it. Point the trigger at a project YAML instead. The YAML resolves
// {DEPICTIO_DATA_ROOT}, which the trigger exports from the data root.
params.depictio_project_config = "${projectDir}/depictio_project.yaml"
params.depictio_project = 'Nextflow trigger example'

// Order does not matter: every default in depictio.config keeps a value that is
// already set, so this include works before or after the params above.
includeConfig '../depictio.config'
