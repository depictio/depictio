/*
 * ============================================================================
 *  Depictio trigger: every option, annotated
 * ============================================================================
 *
 *  A reference, not a starting point. Copy the blocks you need; the minimal
 *  useful config is the includeConfig line alone (see "Minimal" at the bottom).
 *
 *  Each option is annotated with exactly what it adds to the command the
 *  handler runs. Those command lines are captured from real runs, not written
 *  from memory: `nextflow run <pipeline> -c this.config` logs the full argv
 *  under `[depictio]` before executing it, so you can always check yours.
 *
 *  This is ONE file. The includeConfig line and your settings live together;
 *  there is no second config to provide. Nextflow lets the last `-c` win
 *  outright rather than merging them, so splitting the include and the options
 *  across two files is a way to lose settings for no benefit.
 *
 *  Ordering note: none of the assignments below are order-sensitive, and it does
 *  not matter whether they come before or after the include. The trigger writes
 *  nothing into `params` when it is parsed and reads every setting at
 *  completion, so it has nothing to overwrite. A `--depictio_*` on the command
 *  line always wins.
 * ============================================================================
 */

includeConfig '/path/to/depictio.config'

// ----------------------------------------------------------------------------
// Master switch
// ----------------------------------------------------------------------------
// false disables the trigger entirely: nothing runs, nothing is logged, the
// pipeline is untouched. Useful to keep the include in a shared config and turn
// it off per run with `--depictio_enabled false`.
params.depictio_enabled = true

// ----------------------------------------------------------------------------
// What to ingest
// ----------------------------------------------------------------------------
// Adds: --data-root <absolute path>
// Defaults to params.outdir, which is what nf-core pipelines all define, so
// this is rarely worth setting. A relative path is resolved against launchDir.
// This path is also what gets recorded in the project, so it must stay valid
// after the run: point it at published results, never at a scratch directory
// that gets cleaned.
params.depictio_data_root = null

// ----------------------------------------------------------------------------
// Which Depictio instance, and as whom
// ----------------------------------------------------------------------------
// Adds: --CLI-config-path <path>
// The YAML generated by the Depictio UI (Profile > CLI agents). It carries the
// API URL, the token and the S3 credentials, so nothing has to be written by
// hand. Defaults to $DEPICTIO_CLI_CONFIG_PATH, else ~/.depictio/CLI.yaml.
//
// For CI, leave this alone and set DEPICTIO_CLI_TOKEN and
// DEPICTIO_CLI_API_BASE_URL in the environment instead: the token then comes
// from a secret rather than a file on disk.
params.depictio_cli_config = '/srv/depictio/CLI.yaml'

// Adds: --user <email>
// Multi-user clusters only. Creates-or-gets that account, runs the ingestion as
// them, and prints a passwordless login link to their dashboard at the end.
// Needs the provisioning secret, which Typer reads from
// DEPICTIO_AUTH_PROVISIONING_API_KEY, so there is no parameter for it here.
params.depictio_user = 'alice@lab.org'

// ----------------------------------------------------------------------------
// Which project shape: template, or your own YAML
// ----------------------------------------------------------------------------
// Adds: --template <id>
// Only needed to override what the pipeline manifest already implies. The
// handler always forwards `workflow.manifest` as
// --pipeline-id <name>/<version>, and for a pipeline Depictio ships a
// template for that resolves on its own. Set this to pin a different version,
// or to use a template for a pipeline whose manifest says something else.
// 'latest' resolves to the newest shipped version.
params.depictio_template = 'nf-core/ampliseq/latest'

// Adds: --project-config-path <path>
// The escape hatch for a pipeline Depictio ships no template for. Wins over
// --template, and the manifest is then forwarded but ignored. The YAML can
// interpolate {DEPICTIO_DATA_ROOT}, which the handler exports into the
// process environment, so one file works for every run.
//
// Mutually exclusive with depictio_template: setting both makes the CLI exit 1.
params.depictio_project_config = null

// ----------------------------------------------------------------------------
// Which project, and what to do if it already exists
// ----------------------------------------------------------------------------
// Adds: --project-name <name>
// Without it the project takes the template's own name, which means every run
// of the same pipeline targets the same project. Set it to get one project per
// study, per cohort, or per run, whichever you want.
params.depictio_project = 'TREC 16S survey'

// Adds: --update-config --overwrite
// A second run of the same pipeline finds its project already there, and the
// CLI refuses to touch it. That is the right default, but it stops every
// re-run, so set this to refresh the project in place instead.
//
// --overwrite is not optional and comes along automatically: the delta tables
// from the first ingestion are already written, and without it every data
// collection fails with "already exists, use update=True to update it".
// Dashboards to import next to the data. One path or a list. A template brings
// its own, so this is for pipelines Depictio ships no template for: without it
// the run ends with an ingested project and nothing to look at. The dashboard's
// project_tag must match the project name, and its workflow_tag /
// data_collection_tag values must match the project YAML.
params.depictio_dashboard = "${projectDir}/depictio_dashboard.yaml"

params.depictio_update = true

// Adds: --attach-run
// The other answer to "it already exists": keep the previous runs and add this
// one, rather than refreshing in place. The project ends up holding both run
// directories and the tables are rebuilt from all of them.
//
// Implies --update-config and --overwrite, so the handler does not stack them:
// with attach set, depictio_update above is ignored. It also skips the
// dashboard import, since re-importing would overwrite edits made since.
//
// The project must already exist. If it does not, the CLI stops with exit 2
// and says so rather than quietly creating one.
params.depictio_attach = false

// ----------------------------------------------------------------------------
// How to reach the CLI
// ----------------------------------------------------------------------------
// A plain string is the common case: a name on PATH, or an absolute path.
//
//   params.depictio_cli_executable = 'depictio-cli'
//   params.depictio_cli_executable = '/opt/depictio/venv/bin/depictio-cli'
//
// A list wraps it, which is how the published container is used without
// installing anything. The image sets depictio-cli as its entrypoint, so the
// list stops at the image name and the handler appends `run` and its options.
//
// {DATA_ROOT} is substituted at completion and is the only way to mount the
// directory being ingested: the list is built when this config is PARSED, and
// params.outdir does not exist yet at that point, so a "${params.outdir}"
// written here expands to the string "null" and docker mounts a directory
// called null. System.getProperty works inline, which is why a home path can be
// interpolated normally.
//
// Both binds map a host path onto the same path inside the container. That is
// required, not stylistic: the handler passes absolute host paths as
// --data-root and --CLI-config-path, and the data root is what ends up recorded
// in the project.
params.depictio_cli_executable = [
    'docker', 'run', '--rm',
    '-v', '{DATA_ROOT}:{DATA_ROOT}',
    '-v', '/srv/depictio:/srv/depictio:ro',
    '--network', 'host',
    'ghcr.io/depictio/depictio-cli:1.9.2',
]

/*
 * ============================================================================
 *  Smaller versions
 * ============================================================================
 *
 *  Minimal. Every option above is optional; for an nf-core pipeline this line
 *  is the whole configuration, because the manifest identifies the pipeline and
 *  params.outdir says what to ingest:
 *
 *      includeConfig '/path/to/depictio.config'
 *
 *  Command it runs:
 *      depictio-cli run --CLI-config-path ~/.depictio/CLI.yaml
 *          --data-root <outdir> --triggered-by nextflow
 *          --pipeline-id nf-core/ampliseq/2.16.0
 *
 *  Nothing at all. Put that same includeConfig line in ~/.nextflow/config and
 *  every pipeline on the machine ingests on completion, with no -c and no
 *  change to any pipeline.
 *
 *  A named project, refreshed on every re-run:
 *
 *      includeConfig '/path/to/depictio.config'
 *      params.depictio_project = 'TREC 16S survey'
 *      params.depictio_update  = true
 *
 *  Adds: --project-name 'TREC 16S survey' --update-config --overwrite
 *
 *  A named project, accumulating one run per execution:
 *
 *      includeConfig '/path/to/depictio.config'
 *      params.depictio_project = 'TREC 16S survey'
 *      params.depictio_attach  = true
 *
 *  Adds: --project-name 'TREC 16S survey' --attach-run
 *
 *  Per-run override, no config edit. Every option is also a command-line flag,
 *  and the command line always wins:
 *
 *      nextflow run <pipeline> -c depictio.config \
 *          --depictio_project 'Run du jour' --depictio_update true
 * ============================================================================
 */
