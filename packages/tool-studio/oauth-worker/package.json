{
  "name": "depictio-tool-studio-oauth",
  "version": "0.1.0",
  "private": true,
  "description": "Cloudflare Worker performing the GitHub OAuth code->token exchange for Tool Studio.",
  "scripts": {
    "login": "wrangler login",
    "check": "wrangler deploy --dry-run",
    "secret": "wrangler secret put GH_CLIENT_SECRET",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev"
  },
  "devDependencies": {
    "wrangler": "4.86.0"
  },
  "engines": {
    "node": ">=20.3.0"
  }
}
