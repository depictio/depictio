{
  "name": "tool-studio",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Depictio Tool Studio — 100% client-side web app to author a catalog tool entry (module.yaml + <output>.yaml + fixture) from a dropped CSV/TSV, preview visualizations, and export a zip or open a PR.",
  "scripts": {
    "genkinds": "tsx scripts/genKinds.ts",
    "prebuild": "tsx scripts/genKinds.ts",
    "predev": "tsx scripts/genKinds.ts",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test",
    "bump": "npm version --no-git-tag-version"
  },
  "dependencies": {
    "@iconify/react": "^5.0.2",
    "@mantine/code-highlight": "^7.14.0",
    "@mantine/core": "^7.14.0",
    "@mantine/dates": "^7.14.0",
    "@mantine/hooks": "^7.14.0",
    "@mantine/notifications": "^7.14.0",
    "@monaco-editor/react": "^4.6.0",
    "ag-grid-community": "^32.3.0",
    "ag-grid-react": "^32.3.0",
    "dayjs": "^1.11.10",
    "depictio-components": "file:../depictio-components",
    "depictio-react-core": "file:../depictio-react-core",
    "js-yaml": "^4.1.0",
    "jszip": "^3.10.1",
    "papaparse": "^5.4.1",
    "plotly.js": "^2.35.0",
    "pyodide": "^0.26.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-grid-layout": "^1.4.4",
    "react-plotly.js": "^2.6.0",
    "react-resizable": "^3.0.5",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/js-yaml": "^4.0.9",
    "@types/papaparse": "^5.3.14",
    "@types/plotly.js": "^2.33.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/react-plotly.js": "^2.6.3",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "2.1.9",
    "jsdom": "^25.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.3.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
