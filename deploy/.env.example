# Copy to `.env` next to docker-compose.watcher.yaml and fill in.
# See docs/automated-ingestion.md for what each option does.

# ── Required ────────────────────────────────────────────────────────────────

# Data root on the host. Mounted read-only.
DEPICTIO_DATA_ROOT=/srv/pipelines/myproject/results

# CLI credentials, and the project to keep ingested.
DEPICTIO_CLI_CONFIG=/home/alice/.depictio/CLI.yaml
DEPICTIO_PROJECT_CONFIG=/srv/projects/myproject/project.yaml

# ── Optional ────────────────────────────────────────────────────────────────

# Where the data root appears inside the container. Must match the paths in
# your project config — if the config says /data/run_01, mount it at /data.
DEPICTIO_DATA_ROOT_MOUNT=/data

DEPICTIO_CLI_IMAGE=ghcr.io/depictio/depictio-cli:latest
WATCHER_NAME=depictio-watcher

# incremental: only new/changed files (pair with replace-runs).
# full: re-scan and rewrite everything each cycle — expensive, for schema
#       changes or upstream rewrites only.
DEPICTIO_WATCH_MODE=incremental
DEPICTIO_WATCH_WRITE_MODE=replace-runs

# polling is the default in containers: inotify does not cross bind mounts
# reliably. On a bare-metal watcher over local disk, `auto` is better.
DEPICTIO_WATCH_BACKEND=polling
DEPICTIO_WATCH_INTERVAL=300

# Quiet period before a cycle starts, and how long a file must hold the same
# size+mtime before it is considered fully written.
DEPICTIO_WATCH_DEBOUNCE=30
DEPICTIO_WATCH_SETTLE=5
