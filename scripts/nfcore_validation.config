/*
 * Campaign overrides for scripts/nfcore_validation_hpc.py.
 *
 * Loaded AFTER /scratch/tweber/NF_CORE/nf_slurm.config, which this does not
 * replace: that file owns the executor, the account, the queue, the resource
 * limits and the shared Singularity cache, and it predates this campaign.
 * Only what the validation runs additionally need belongs here.
 */

env {
    /*
     * Nextflow forwards the host TMPDIR into the container verbatim - the task
     * launcher writes ${TMPDIR:+SINGULARITYENV_TMPDIR="$TMPDIR"} - while
     * autoMounts binds only the run root. A node-local TMPDIR is therefore a
     * path that does not exist inside the image, and anything that calls
     * mkdtemp fails on a name that looks perfectly valid from outside. Quarto
     * is the first tool to notice: nf-core/differentialabundance dies in
     * QUARTONOTEBOOK with "NotFound: No such file or directory (os error 2):
     * tmpdir".
     *
     * The fix has to be PER TASK, not a shared directory. A single campaign-wide
     * TMPDIR looks safe as long as every consumer goes through mkdtemp, and that
     * assumption is wrong: QIIME2 puts its cache lock at the FIXED path
     * $TMPDIR/qiime2/$USER/LOCK, so concurrent QIIME2 tasks on different nodes
     * contend for one lock file over the network filesystem and flufl.lock dies
     * with "OSError: [Errno 121] Remote I/O error". That took out
     * nf-core/ampliseq at QIIME2_DIVERSITY_ALPHA.
     *
     * It also has to be SHORT. $NXF_TASK_WORKDIR itself is the obvious per-task
     * directory and it is what QIIME2 needs, but it is ~95 characters here
     * (/scratch/tweber/NF_CORE/<pipeline>/<version>/work_<profile>/xx/<30 hex>),
     * and a Unix domain socket path is capped at 108 bytes. Python's
     * multiprocessing.Manager() appends ~32 more characters below it, so
     * nf-core/ampliseq's SIDLE route died in SIDLE_DBFILT with
     * "OSError: AF_UNIX path too long" from rescript's cull_seqs.
     *
     * So: a short root inside the bind, plus the task hash for uniqueness, built
     * and created by the value itself. nxf_container_env() writes this into a
     * heredoc that the task evals INSIDE the container, after cd'ing to the work
     * directory, so a command substitution here runs per task and the directory
     * exists before any tool looks for it. The fallback keeps a task alive if the
     * mkdir ever fails rather than handing a tool an empty TMPDIR.
     */
    TMPDIR = '$(t=/scratch/tweber/NF_CORE/tmp/${NXF_TASK_WORKDIR##*/}; mkdir -p "$t" 2>/dev/null && echo "$t" || echo /scratch/tweber/NF_CORE/tmp)'
}

/*
 * The retry loop in the head job re-runs `nextflow run` with -resume, but the
 * DSL1-era pipelines write their trace, timeline, report and DAG to fixed names
 * and refuse to clobber them: the second attempt dies on "Trace file already
 * exists -- enable the 'trace.overwrite' option" before it reaches the work it
 * was retrying. Without this, a retry can only ever succeed on a pipeline whose
 * first attempt wrote no trace at all.
 */
trace { overwrite = true }
timeline { overwrite = true }
report { overwrite = true }
dag { overwrite = true }
